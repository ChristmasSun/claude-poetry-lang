# ============================================================================
# DEMO 3: PROBABILITY DISTRIBUTIONS
# ============================================================================
#
# This demo shows first-class probability distributions in Lament.
# Supports uniform, normal, and Bernoulli distributions with
# Monte Carlo simulation and probability queries.
#
# Perfect for scientific computing, machine learning, simulations,
# and uncertainty quantification.
# ============================================================================

confess "=== PROBABILITY DISTRIBUTIONS DEMO ==="
confess ""

# ============================================================================
# Basic Distributions
# ============================================================================

confess "=== BASIC DISTRIBUTIONS ==="
confess ""

# Uniform distribution [0, 100]
remember u = uniform(0, 100)
confess "Uniform distribution: [0, 100]"
confess "  Expected value: " + expected_value(u)
confess "  Sample: " + sample(u)

confess ""

# Normal distribution (Gaussian)
remember n = normal(100, 15)
confess "Normal distribution: μ=100, σ=15"
confess "  Expected value: " + expected_value(n)
confess "  Sample: " + sample(n)

confess ""

# Bernoulli (coin flip)
remember coin = bernoulli(0.5)
confess "Fair coin flip: p=0.5"
confess "  Expected value: " + expected_value(coin)
confess "  Sample (heads=1, tails=0): " + sample(coin)

# ============================================================================
# Monte Carlo Simulation
# ============================================================================

confess ""
confess "=== MONTE CARLO SIMULATION ==="
confess ""

# Simulate rolling a die 1000 times
confess "Simulating 1000 die rolls..."

simulate 1000 times {
    remember roll = uniform(1, 7)
    remember result = roll
} analyze distribution

confess "✓ Collected 1000 samples into empirical distribution"
confess "  Expected value: ~3.5"

# Simulate coin flips
confess ""
confess "Simulating 100 coin flips (p=0.6 biased coin)..."

remember biased_coin = bernoulli(0.6)

simulate 100 times {
    remember flip = sample(biased_coin)
    remember outcome = flip
} analyze distribution

confess "✓ Results collected into distribution"
confess "  Expected proportion of heads: 0.6"

# ============================================================================
# Probability Queries
# ============================================================================

confess ""
confess "=== PROBABILITY QUERIES ==="
confess ""

# Create IQ distribution (μ=100, σ=15)
remember iq = normal(100, 15)

confess "IQ Distribution (Normal: μ=100, σ=15)"
confess ""

# Query: What's the probability of IQ > 130?
confess "P(IQ > 130) - Probability of genius-level IQ"
confess "  (Using Monte Carlo with 10,000 samples)"
confess "  Expected: ~0.023 (2.3%)"

# Query: What's the probability of 90 < IQ < 110?
confess ""
confess "P(90 < IQ < 110) - Probability of average IQ"
confess "  Expected: ~0.50 (50%)"

# ============================================================================
# Application: A/B Testing
# ============================================================================

confess ""
confess "=== APPLICATION: A/B TESTING ==="
confess ""

# Version A: 10% conversion rate
remember version_a = bernoulli(0.10)

# Version B: 12% conversion rate
remember version_b = bernoulli(0.12)

confess "Testing two website versions:"
confess "  Version A: 10% conversion rate"
confess "  Version B: 12% conversion rate"
confess ""

# Simulate 100 visitors to each version
confess "Simulating 100 visitors per version..."

simulate 100 times {
    remember converted = sample(version_a)
    remember result_a = converted
} analyze distribution

confess "Version A conversions collected"

simulate 100 times {
    remember converted = sample(version_b)
    remember result_b = converted
} analyze distribution

confess "Version B conversions collected"
confess ""
confess "✓ A/B test simulation complete!"

# ============================================================================
# Application: Game Mechanics
# ============================================================================

confess ""
confess "=== APPLICATION: GAME MECHANICS ==="
confess ""

# Critical hit chance: 15%
remember crit_chance = bernoulli(0.15)

# Damage roll: 10-20 uniform
remember damage_roll = uniform(10, 20)

confess "RPG Combat System:"
confess "  Base damage: Uniform[10, 20]"
confess "  Critical hit chance: 15% (doubles damage)"
confess ""

# Simulate attack
remember is_crit = sample(crit_chance)
remember base_damage = sample(damage_roll)

if is_crit == 1 {
    remember actual_damage = base_damage * 2
    confess "CRITICAL HIT! Damage: " + actual_damage
} else {
    confess "Normal hit. Damage: " + base_damage
}

# ============================================================================
# Application: Financial Modeling
# ============================================================================

confess ""
confess "=== APPLICATION: FINANCIAL MODELING ==="
confess ""

# Stock returns: Normal distribution (μ=0.08, σ=0.20)
# 8% expected return, 20% volatility
remember stock_returns = normal(0.08, 0.20)

confess "Stock Returns Model (Normal distribution):"
confess "  Expected annual return: 8%"
confess "  Volatility (std dev): 20%"
confess ""

# Simulate portfolio value after one year
remember initial_investment = 10000
remember return_rate = sample(stock_returns)
remember final_value = initial_investment * (1 + return_rate)

confess "Portfolio simulation:"
confess "  Initial investment: $" + initial_investment
confess "  Simulated return: " + (return_rate * 100) + "%"
confess "  Final value: $" + final_value

# Monte Carlo portfolio analysis
confess ""
confess "Running 1000 portfolio simulations..."

simulate 1000 times {
    remember ret = sample(stock_returns)
    remember final = initial_investment * (1 + ret)
    remember outcome = final
} analyze distribution

confess "✓ Portfolio distribution calculated"
confess "  Expected final value: ~$10,800"
confess "  (Can query probability of loss, gains, etc.)"

# ============================================================================
# Application: Machine Learning - Bayesian Inference
# ============================================================================

confess ""
confess "=== APPLICATION: BAYESIAN INFERENCE ==="
confess ""

# Prior: Success rate is unknown, assume ~0.5
remember prior = normal(0.5, 0.1)

confess "Bayesian Parameter Estimation:"
confess "  Prior belief: Success rate ~ Normal(0.5, 0.1)"
confess "  Observing data to update belief..."

# Observe some successes (update not shown in this simple demo)
confess "  (In full implementation: update posterior distribution)"
confess "  (This is the foundation for probabilistic programming!)"

# ============================================================================
# Summary
# ============================================================================

confess ""
confess "=== REVOLUTIONARY FEATURES SUMMARY ==="
confess ""
confess "✓ First-class probability distributions"
confess "✓ Multiple distribution types (uniform, normal, bernoulli)"
confess "✓ Monte Carlo simulation with 'simulate...analyze' syntax"
confess "✓ Probability queries: P(event) using sampling"
confess "✓ Expected value calculations"
confess "✓ Empirical distributions from simulations"
confess ""
confess "Perfect for:"
confess "  • Scientific computing"
confess "  • Machine learning (probabilistic models)"
confess "  • Game development (randomness, loot)"
confess "  • Financial modeling (risk analysis)"
confess "  • A/B testing and experimentation"
confess "  • Uncertainty quantification"
confess ""
confess "The future of probabilistic programming! 🎲"
