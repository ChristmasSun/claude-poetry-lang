#!/usr/bin/env python3
"""
Lament CLI Wrapper
Convenience script to run the Lament CLI from anywhere in the project.
"""
import sys
import os

# Add parent directory to path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Import and run CLI
from lament.cli import main

if __name__ == '__main__':
    sys.exit(main())
