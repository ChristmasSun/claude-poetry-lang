# ============================================================================
# LAMENT STANDARD LIBRARY - DATETIME MODULE
# ============================================================================
# Date and time operations
# Provides date parsing, formatting, arithmetic, and timezone handling
# ============================================================================

# ============================================================================
# CONSTANTS
# ============================================================================

remember SECONDS_PER_MINUTE = 60
remember SECONDS_PER_HOUR = 3600
remember SECONDS_PER_DAY = 86400
remember DAYS_PER_WEEK = 7

remember MONTH_NAMES = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
]

remember MONTH_NAMES_SHORT = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]

remember DAY_NAMES = [
    "Sunday", "Monday", "Tuesday", "Wednesday",
    "Thursday", "Friday", "Saturday"
]

remember DAY_NAMES_SHORT = [
    "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
]

# ============================================================================
# CURRENT TIME
# ============================================================================

sigh now() {
    # Get current timestamp (seconds since epoch)
    exhale get_timestamp()
}

sigh today() {
    # Get today's date as DateTime object
    remember timestamp = now()
    exhale from_timestamp(timestamp)
}

sigh utc_now() {
    # Get current UTC timestamp
    exhale get_utc_timestamp()
}

# ============================================================================
# DATETIME OBJECT
# ============================================================================

sigh DateTime_new(year, month, day, hour, minute, second) {
    # Create DateTime object
    if hour == void {
        hour = 0
    }
    if minute == void {
        minute = 0
    }
    if second == void {
        second = 0
    }

    remember obj = {
        "year": year,
        "month": month,
        "day": day,
        "hour": hour,
        "minute": minute,
        "second": second,
        "timestamp": void,
        "format": void,
        "add_days": void,
        "add_hours": void,
        "add_minutes": void,
        "add_seconds": void,
        "diff": void,
        "weekday": void,
        "to_string": void
    }

    # Calculate timestamp
    obj["timestamp"] = date_to_timestamp(year, month, day, hour, minute, second)

    sigh format_fn(format_str) {
        exhale format_date(obj, format_str)
    }

    sigh add_days_fn(days) {
        remember new_timestamp = obj["timestamp"] + days * SECONDS_PER_DAY
        exhale from_timestamp(new_timestamp)
    }

    sigh add_hours_fn(hours) {
        remember new_timestamp = obj["timestamp"] + hours * SECONDS_PER_HOUR
        exhale from_timestamp(new_timestamp)
    }

    sigh add_minutes_fn(minutes) {
        remember new_timestamp = obj["timestamp"] + minutes * SECONDS_PER_MINUTE
        exhale from_timestamp(new_timestamp)
    }

    sigh add_seconds_fn(seconds) {
        remember new_timestamp = obj["timestamp"] + seconds
        exhale from_timestamp(new_timestamp)
    }

    sigh diff_fn(other_dt) {
        remember diff_seconds = obj["timestamp"] - other_dt["timestamp"]
        exhale TimeDelta_new(diff_seconds)
    }

    sigh weekday_fn() {
        # Calculate day of week (0 = Sunday, 6 = Saturday)
        remember days_since_epoch = obj["timestamp"] / SECONDS_PER_DAY
        remember day_of_week = (days_since_epoch + 4) % 7  # Epoch was Thursday
        exhale to_int(day_of_week)
    }

    sigh to_string_fn() {
        exhale format_date(obj, "%Y-%m-%d %H:%M:%S")
    }

    obj["format"] = format_fn
    obj["add_days"] = add_days_fn
    obj["add_hours"] = add_hours_fn
    obj["add_minutes"] = add_minutes_fn
    obj["add_seconds"] = add_seconds_fn
    obj["diff"] = diff_fn
    obj["weekday"] = weekday_fn
    obj["to_string"] = to_string_fn

    exhale obj
}

sigh from_timestamp(timestamp) {
    # Create DateTime from timestamp
    remember components = timestamp_to_date(timestamp)

    exhale DateTime_new(
        components["year"],
        components["month"],
        components["day"],
        components["hour"],
        components["minute"],
        components["second"]
    )
}

# ============================================================================
# TIMEDELTA (Time differences)
# ============================================================================

sigh TimeDelta_new(seconds) {
    # Create TimeDelta object representing a time difference
    remember obj = {
        "total_seconds": seconds,
        "days": void,
        "hours": void,
        "minutes": void,
        "seconds": void,
        "to_string": void
    }

    # Calculate components
    remember remaining = abs(seconds)
    remember days = to_int(remaining / SECONDS_PER_DAY)
    remaining = remaining - days * SECONDS_PER_DAY

    remember hours = to_int(remaining / SECONDS_PER_HOUR)
    remaining = remaining - hours * SECONDS_PER_HOUR

    remember minutes = to_int(remaining / SECONDS_PER_MINUTE)
    remaining = remaining - minutes * SECONDS_PER_MINUTE

    obj["days"] = days
    obj["hours"] = hours
    obj["minutes"] = minutes
    obj["seconds"] = to_int(remaining)

    sigh to_string_fn() {
        remember sign = ""
        if obj["total_seconds"] < 0 {
            sign = "-"
        }

        if obj["days"] > 0 {
            exhale "${sign}${obj["days"]} days, ${obj["hours"]}:${pad_zero(obj["minutes"])}:${pad_zero(obj["seconds"])}"
        }

        exhale "${sign}${obj["hours"]}:${pad_zero(obj["minutes"])}:${pad_zero(obj["seconds"])}"
    }

    obj["to_string"] = to_string_fn

    exhale obj
}

sigh timedelta(days, hours, minutes, seconds) {
    # Create TimeDelta from components
    if days == void {
        days = 0
    }
    if hours == void {
        hours = 0
    }
    if minutes == void {
        minutes = 0
    }
    if seconds == void {
        seconds = 0
    }

    remember total = days * SECONDS_PER_DAY + hours * SECONDS_PER_HOUR + minutes * SECONDS_PER_MINUTE + seconds

    exhale TimeDelta_new(total)
}

# ============================================================================
# DATE PARSING
# ============================================================================

sigh parse_date(date_str, format_str) {
    # Parse date string according to format
    # Supports: %Y (year), %m (month), %d (day), %H (hour), %M (minute), %S (second)

    if format_str == void {
        format_str = "%Y-%m-%d"
    }

    remember components = {
        "year": 1970,
        "month": 1,
        "day": 1,
        "hour": 0,
        "minute": 0,
        "second": 0
    }

    # Simple parsing logic
    remember format_len = string_length(format_str)
    remember date_len = string_length(date_str)
    remember format_idx = 0
    remember date_idx = 0

    while format_idx < format_len and date_idx < date_len {
        remember format_ch = char_at(format_str, format_idx)

        if format_ch == "%" and format_idx + 1 < format_len {
            remember spec = char_at(format_str, format_idx + 1)

            if spec == "Y" {
                # 4-digit year
                components["year"] = parse_int(substring_str(date_str, date_idx, date_idx + 4))
                date_idx = date_idx + 4
            } else {
                if spec == "m" or spec == "d" or spec == "H" or spec == "M" or spec == "S" {
                    # 2-digit component
                    remember value = parse_int(substring_str(date_str, date_idx, date_idx + 2))

                    if spec == "m" {
                        components["month"] = value
                    } else {
                        if spec == "d" {
                            components["day"] = value
                        } else {
                            if spec == "H" {
                                components["hour"] = value
                            } else {
                                if spec == "M" {
                                    components["minute"] = value
                                } else {
                                    if spec == "S" {
                                        components["second"] = value
                                    }
                                }
                            }
                        }
                    }

                    date_idx = date_idx + 2
                }
            }

            format_idx = format_idx + 2
        } else {
            # Skip literal character
            format_idx = format_idx + 1
            date_idx = date_idx + 1
        }
    }

    exhale DateTime_new(
        components["year"],
        components["month"],
        components["day"],
        components["hour"],
        components["minute"],
        components["second"]
    )
}

# ============================================================================
# DATE FORMATTING
# ============================================================================

sigh format_date(dt, format_str) {
    # Format DateTime object as string
    if format_str == void {
        format_str = "%Y-%m-%d %H:%M:%S"
    }

    remember result = ""
    remember i = 0
    remember len = string_length(format_str)

    while i < len {
        remember ch = char_at(format_str, i)

        if ch == "%" and i + 1 < len {
            remember spec = char_at(format_str, i + 1)

            if spec == "Y" {
                result = "${result}${dt["year"]}"
            } else {
                if spec == "m" {
                    result = "${result}${pad_zero(dt["month"])}"
                } else {
                    if spec == "d" {
                        result = "${result}${pad_zero(dt["day"])}"
                    } else {
                        if spec == "H" {
                            result = "${result}${pad_zero(dt["hour"])}"
                        } else {
                            if spec == "M" {
                                result = "${result}${pad_zero(dt["minute"])}"
                            } else {
                                if spec == "S" {
                                    result = "${result}${pad_zero(dt["second"])}"
                                } else {
                                    if spec == "B" {
                                        # Full month name
                                        result = "${result}${MONTH_NAMES[dt["month"] - 1]}"
                                    } else {
                                        if spec == "b" {
                                            # Short month name
                                            result = "${result}${MONTH_NAMES_SHORT[dt["month"] - 1]}"
                                        } else {
                                            if spec == "A" {
                                                # Full day name
                                                remember wd = dt["weekday"]()
                                                result = "${result}${DAY_NAMES[wd]}"
                                            } else {
                                                if spec == "a" {
                                                    # Short day name
                                                    remember wd = dt["weekday"]()
                                                    result = "${result}${DAY_NAMES_SHORT[wd]}"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            i = i + 2
        } else {
            result = "${result}${ch}"
            i = i + 1
        }
    }

    exhale result
}

# ============================================================================
# DATE ARITHMETIC
# ============================================================================

sigh add_days(dt, days) {
    # Add days to DateTime
    exhale dt["add_days"](days)
}

sigh add_hours(dt, hours) {
    # Add hours to DateTime
    exhale dt["add_hours"](hours)
}

sigh add_minutes(dt, minutes) {
    # Add minutes to DateTime
    exhale dt["add_minutes"](minutes)
}

sigh add_seconds(dt, seconds) {
    # Add seconds to DateTime
    exhale dt["add_seconds"](seconds)
}

sigh subtract_dates(dt1, dt2) {
    # Get difference between two dates
    exhale dt1["diff"](dt2)
}

# ============================================================================
# DATE UTILITIES
# ============================================================================

sigh is_leap_year(year) {
    # Check if year is leap year
    if year % 4 != 0 {
        exhale no
    }

    if year % 100 != 0 {
        exhale yes
    }

    if year % 400 == 0 {
        exhale yes
    }

    exhale no
}

sigh days_in_month(year, month) {
    # Get number of days in month
    if month == 2 {
        if is_leap_year(year) {
            exhale 29
        }
        exhale 28
    }

    if month == 4 or month == 6 or month == 9 or month == 11 {
        exhale 30
    }

    exhale 31
}

sigh weekday(dt) {
    # Get day of week (0=Sunday, 6=Saturday)
    exhale dt["weekday"]()
}

sigh weekday_name(dt, short) {
    # Get name of day of week
    if short == void {
        short = no
    }

    remember wd = dt["weekday"]()

    if short {
        exhale DAY_NAMES_SHORT[wd]
    }

    exhale DAY_NAMES[wd]
}

sigh month_name(month, short) {
    # Get name of month
    if short == void {
        short = no
    }

    if short {
        exhale MONTH_NAMES_SHORT[month - 1]
    }

    exhale MONTH_NAMES[month - 1]
}

sigh is_weekend(dt) {
    # Check if date is weekend
    remember wd = dt["weekday"]()
    exhale wd == 0 or wd == 6
}

sigh is_weekday(dt) {
    # Check if date is weekday
    exhale not is_weekend(dt)
}

# ============================================================================
# TIMEZONE SUPPORT
# ============================================================================

sigh Timezone_new(name, offset_hours) {
    # Create Timezone object
    remember obj = {
        "name": name,
        "offset_seconds": offset_hours * SECONDS_PER_HOUR,
        "offset_hours": offset_hours,
        "convert": void
    }

    sigh convert_fn(dt) {
        # Convert DateTime to this timezone
        remember new_timestamp = dt["timestamp"] + obj["offset_seconds"]
        remember converted = from_timestamp(new_timestamp)
        exhale converted
    }

    obj["convert"] = convert_fn

    exhale obj
}

sigh utc_timezone() {
    exhale Timezone_new("UTC", 0)
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

sigh pad_zero(num) {
    # Pad number with leading zero
    if num < 10 {
        exhale "0${num}"
    }
    exhale to_string(num)
}

sigh date_to_timestamp(year, month, day, hour, minute, second) {
    # Convert date components to timestamp (simplified)
    # This is a simplified calculation - real implementation would need proper date arithmetic

    remember days = 0

    # Count leap years
    remember y = 1970
    while y < year {
        if is_leap_year(y) {
            days = days + 366
        } else {
            days = days + 365
        }
        y = y + 1
    }

    # Add days for months
    remember m = 1
    while m < month {
        days = days + days_in_month(year, m)
        m = m + 1
    }

    # Add days
    days = days + day - 1

    # Convert to seconds
    remember total = days * SECONDS_PER_DAY + hour * SECONDS_PER_HOUR + minute * SECONDS_PER_MINUTE + second

    exhale total
}

sigh timestamp_to_date(timestamp) {
    # Convert timestamp to date components (simplified)
    remember year = 1970
    remember remaining_seconds = timestamp

    # Calculate year
    remember seconds_in_year = 365 * SECONDS_PER_DAY

    while remaining_seconds >= seconds_in_year {
        if is_leap_year(year) {
            seconds_in_year = 366 * SECONDS_PER_DAY
        } else {
            seconds_in_year = 365 * SECONDS_PER_DAY
        }

        if remaining_seconds >= seconds_in_year {
            remaining_seconds = remaining_seconds - seconds_in_year
            year = year + 1
        } else {
            break
        }
    }

    # Calculate month and day
    remember month = 1
    remember remaining_days = remaining_seconds / SECONDS_PER_DAY

    while month <= 12 {
        remember days_this_month = days_in_month(year, month)

        if remaining_days >= days_this_month {
            remaining_days = remaining_days - days_this_month
            month = month + 1
        } else {
            break
        }
    }

    remember day = to_int(remaining_days) + 1
    remaining_seconds = remaining_seconds % SECONDS_PER_DAY

    remember hour = to_int(remaining_seconds / SECONDS_PER_HOUR)
    remaining_seconds = remaining_seconds % SECONDS_PER_HOUR

    remember minute = to_int(remaining_seconds / SECONDS_PER_MINUTE)
    remember second = to_int(remaining_seconds % SECONDS_PER_MINUTE)

    exhale {
        "year": year,
        "month": month,
        "day": day,
        "hour": hour,
        "minute": minute,
        "second": second
    }
}

sigh substring_str(text, start, end) {
    exhale substring(text, start, end)
}

# ============================================================================
# EXPORT PUBLIC API
# ============================================================================

expose {
    now, today, utc_now,
    DateTime_new, from_timestamp,
    TimeDelta_new, timedelta,
    parse_date, format_date,
    add_days, add_hours, add_minutes, add_seconds, subtract_dates,
    is_leap_year, days_in_month, weekday, weekday_name, month_name,
    is_weekend, is_weekday,
    Timezone_new, utc_timezone,
    MONTH_NAMES, MONTH_NAMES_SHORT, DAY_NAMES, DAY_NAMES_SHORT
}
