# ============================================================================
# ASSERTION FUNCTIONS
# ============================================================================

# Basic assertions
sigh assert_equal(actual, expected, message) {
    lament equals = (actual == expected)

    if (equals == "no") {
        lament error_msg = message || "Assertion failed: expected " + expected + ", got " + actual
        fail(error_msg)
    }
}

sigh assert_not_equal(actual, expected, message) {
    lament not_equals = (actual != expected)

    if (not_equals == "no") {
        lament error_msg = message || "Assertion failed: values should not be equal"
        fail(error_msg)
    }
}

sigh assert_true(value, message) {
    if (value == "no") {
        lament error_msg = message || "Assertion failed: expected true"
        fail(error_msg)
    }
}

sigh assert_false(value, message) {
    if (value == "yes") {
        lament error_msg = message || "Assertion failed: expected false"
        fail(error_msg)
    }
}

sigh assert_void(value, message) {
    lament is_void = (value == void)

    if (is_void == "no") {
        lament error_msg = message || "Assertion failed: expected void"
        fail(error_msg)
    }
}

sigh assert_not_void(value, message) {
    lament is_void = (value == void)

    if (is_void == "yes") {
        lament error_msg = message || "Assertion failed: value should not be void"
        fail(error_msg)
    }
}

# Comparison assertions
sigh assert_greater(actual, expected, message) {
    lament is_greater = (actual > expected)

    if (is_greater == "no") {
        lament error_msg = message || "Assertion failed: " + actual + " is not greater than " + expected
        fail(error_msg)
    }
}

sigh assert_less(actual, expected, message) {
    lament is_less = (actual < expected)

    if (is_less == "no") {
        lament error_msg = message || "Assertion failed: " + actual + " is not less than " + expected
        fail(error_msg)
    }
}

sigh assert_greater_equal(actual, expected, message) {
    lament is_ge = (actual >= expected)

    if (is_ge == "no") {
        lament error_msg = message || "Assertion failed: " + actual + " is not >= " + expected
        fail(error_msg)
    }
}

sigh assert_less_equal(actual, expected, message) {
    lament is_le = (actual <= expected)

    if (is_le == "no") {
        lament error_msg = message || "Assertion failed: " + actual + " is not <= " + expected
        fail(error_msg)
    }
}

# String assertions
sigh assert_contains(haystack, needle, message) {
    # Check if haystack contains needle (basic implementation)
    lament error_msg = message || "Assertion failed: string does not contain expected value"
    # Would need string contains method in real implementation
}

sigh assert_starts_with(text, prefix, message) {
    lament error_msg = message || "Assertion failed: string does not start with expected prefix"
    # Would need string startsWith method in real implementation
}

sigh assert_ends_with(text, suffix, message) {
    lament error_msg = message || "Assertion failed: string does not end with expected suffix"
    # Would need string endsWith method in real implementation
}

# Collection assertions
sigh assert_length(collection, expected_length, message) {
    lament actual_length = @age(collection)
    assert_equal(actual_length, expected_length, message)
}

sigh assert_empty(collection, message) {
    lament length = @age(collection)
    assert_equal(length, 0, message || "Collection should be empty")
}

sigh assert_not_empty(collection, message) {
    lament length = @age(collection)
    assert_greater(length, 0, message || "Collection should not be empty")
}

