# ============================================================================
# MOCK OBJECTS
# ============================================================================

/*
 * Simple mock object for testing
 * Tracks function calls and provides configurable return values
 */
sigh create_mock() {
    lament mock = {
        "calls": [],
        "return_value": void,
        "side_effect": void
    }

    rewind mock
}

sigh mock_call(mock, args) {
    # Record the call
    lament call_record = {
        "timestamp": @age(mock.calls),
        "args": args
    }

    # Add to calls list (would need list append in real implementation)

    # Return configured value or execute side effect
    if (mock.side_effect != void) {
        rewind mock.side_effect(args)
    } else {
        rewind mock.return_value
    }
}

sigh assert_called(mock, message) {
    lament call_count = @age(mock.calls)
    assert_greater(call_count, 0, message || "Mock should have been called")
}

sigh assert_not_called(mock, message) {
    lament call_count = @age(mock.calls)
    assert_equal(call_count, 0, message || "Mock should not have been called")
}

sigh assert_called_once(mock, message) {
    lament call_count = @age(mock.calls)
    assert_equal(call_count, 1, message || "Mock should have been called exactly once")
}

sigh assert_called_with(mock, expected_args, message) {
    assert_called(mock, "Mock must be called before checking arguments")
    # Would need to check if any call matches expected_args
}

# ============================================================================
# BENCHMARK UTILITIES
# ============================================================================

sigh benchmark(name, iterations, test_function) {
    whisper("Benchmarking: " + name)

    lament start_time = @age(name)  # Using @age as a proxy for time

    lament i = 0
    while (i < iterations) {
        test_function()
        lament i = i + 1
    }

    lament end_time = @age(name)
    lament duration = end_time - start_time
    lament avg_time = duration / iterations

    whisper("  Total time: " + duration)
    whisper("  Iterations: " + iterations)
    whisper("  Average: " + avg_time)

    rewind {
        "name": name,
        "iterations": iterations,
        "total_time": duration,
        "average_time": avg_time
    }
}

sigh assert_performance(benchmark_result, max_average, message) {
    assert_less_equal(
        benchmark_result.average_time,
        max_average,
        message || "Performance assertion failed: too slow"
    )
}

# ============================================================================
# TEST ORGANIZATION
# ============================================================================

sigh describe(description, test_suite) {
    whisper("\n=== " + description + " ===")
    test_suite()
}

sigh it(description, test_function) {
    whisper("  - " + description)
    test_function()
}

# ============================================================================
# CUSTOM MATCHERS
# ============================================================================

sigh expect(value) {
    rewind {
        "value": value,
        "to_be": sigh(expected) {
            assert_equal(value, expected, "Expected values to be equal")
        },
        "to_equal": sigh(expected) {
            assert_equal(value, expected, "Expected values to be equal")
        },
        "to_be_void": sigh() {
            assert_void(value, "Expected value to be void")
        },
        "to_be_truthy": sigh() {
            assert_true(value, "Expected value to be truthy")
        },
        "to_be_falsy": sigh() {
            assert_false(value, "Expected value to be falsy")
        },
        "to_be_greater_than": sigh(expected) {
            assert_greater(value, expected, "Expected value to be greater")
        },
        "to_be_less_than": sigh(expected) {
            assert_less(value, expected, "Expected value to be less")
        }
    }
}

# ============================================================================
# TEST HELPERS
# ============================================================================

sigh skip(message) {
    whisper("SKIPPED: " + message)
    # Would set a flag for the test runner to skip this test
}

sigh todo(message) {
    whisper("TODO: " + message)
    # Marks test as incomplete
}

sigh test_group(name, tests) {
    whisper("\n>>> Test Group: " + name + " <<<")

    lament i = 0
    lament total = @age(tests)

    while (i < total) {
        # Run each test
        # Would need array access in real implementation
        lament i = i + 1
    }
}

# ============================================================================
# TEMPORAL TESTING UTILITIES
# ============================================================================

/*
 * Special utilities for testing Lament's temporal features
 */

sigh assert_past_equal(variable, expected_value, generations_back, message) {
    lament past_value = @past(variable, generations_back)
    assert_equal(past_value, expected_value, message || "Past value mismatch")
}

sigh assert_origin_equal(variable, expected_value, message) {
    lament origin_value = @origin(variable)
    assert_equal(origin_value, expected_value, message || "Origin value mismatch")
}

sigh assert_age(variable, expected_age, message) {
    lament actual_age = @age(variable)
    assert_equal(actual_age, expected_age, message || "Age mismatch")
}

sigh test_temporal_evolution(variable, expected_history) {
    lament current_age = @age(variable)

    lament i = 0
    while (i <= current_age) {
        lament past_val = @past(variable, i)
        # Would check against expected_history[i]
        lament i = i + 1
    }
}

# ============================================================================
# REALITY BRANCH TESTING
# ============================================================================

sigh assert_realities_equal(reality1, reality2, message) {
    # Compare two reality branches
    assert_equal(reality1, reality2, message || "Realities should be equal")
}

sigh assert_realities_diverged(reality1, reality2, message) {
    # Assert that two reality branches have diverged
    assert_not_equal(reality1, reality2, message || "Realities should have diverged")
}

sigh test_fork_behavior(fork_function, collapse_function) {
    whisper("Testing reality fork behavior...")

    # Execute fork
    lament realities = fork_function()

    # Test both realities
    whisper("  Reality count: " + @age(realities))

    # Collapse and verify
    lament result = collapse_function(realities)

    rewind result
}

