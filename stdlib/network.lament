# ============================================================================
# LAMENT STANDARD LIBRARY - NETWORK MODULE
# ============================================================================
# Networking and HTTP operations
# Provides HTTP requests, URL parsing, WebSocket, and socket operations
# ============================================================================

# ============================================================================
# HTTP CLIENT
# ============================================================================

sigh http_get(url, headers, timeout) {
    # Perform HTTP GET request
    if headers == void {
        headers = {}
    }

    if timeout == void {
        timeout = 30
    }

    attempt {
        remember response = http_request({
            "method": "GET",
            "url": url,
            "headers": headers,
            "timeout": timeout
        })

        exhale response
    } catch error {
        raise "HTTP GET failed for ${url}: ${error}"
    }
}

sigh http_post(url, data, headers, timeout) {
    # Perform HTTP POST request
    if headers == void {
        headers = {}
    }

    if timeout == void {
        timeout = 30
    }

    # Set content-type if not specified
    if not dict_has_key(headers, "Content-Type") {
        headers["Content-Type"] = "application/json"
    }

    # Convert data to JSON if it's a dict
    remember body = data
    if typeof(data) == "dict" {
        body = to_json(data)
    }

    attempt {
        remember response = http_request({
            "method": "POST",
            "url": url,
            "body": body,
            "headers": headers,
            "timeout": timeout
        })

        exhale response
    } catch error {
        raise "HTTP POST failed for ${url}: ${error}"
    }
}

