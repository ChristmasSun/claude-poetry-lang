    }

    if timeout == void {
        timeout = 30
    }

    if not dict_has_key(headers, "Content-Type") {
        headers["Content-Type"] = "application/json"
    }

    remember body = data
    if typeof(data) == "dict" {
        body = to_json(data)
    }

    attempt {
