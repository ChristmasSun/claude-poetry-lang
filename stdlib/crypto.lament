# ============================================================================
# LAMENT STANDARD LIBRARY - CRYPTO MODULE
# ============================================================================
# Cryptography and security utilities
# Provides hashing, encryption, random generation, and encoding
# ============================================================================

# ============================================================================
# HASHING FUNCTIONS
# ============================================================================

sigh hash_md5(data) {
    # Compute MD5 hash
    attempt {
        exhale crypto_hash(data, "md5")
    } catch error {
        raise "MD5 hash failed: ${error}"
    }
}

sigh hash_sha1(data) {
    # Compute SHA-1 hash
    attempt {
        exhale crypto_hash(data, "sha1")
    } catch error {
        raise "SHA-1 hash failed: ${error}"
    }
}

sigh hash_sha256(data) {
    # Compute SHA-256 hash
    attempt {
        exhale crypto_hash(data, "sha256")
    } catch error {
        raise "SHA-256 hash failed: ${error}"
    }
}

sigh hash_sha512(data) {
    # Compute SHA-512 hash
    attempt {
        exhale crypto_hash(data, "sha512")
    } catch error {
        raise "SHA-512 hash failed: ${error}"
    }
}

sigh hash(data, algorithm) {
    # Generic hash function
    if algorithm == void {
        algorithm = "sha256"
    }

    attempt {
        exhale crypto_hash(data, algorithm)
    } catch error {
        raise "Hash failed (${algorithm}): ${error}"
    }
}

sigh hash_file(path, algorithm) {
    # Hash contents of a file
    if algorithm == void {
        algorithm = "sha256"
    }

    attempt {
        import { read_bytes } from "files.lament"
        remember content = read_bytes(path)
        exhale hash(content, algorithm)
    } catch error {
        raise "File hash failed for ${path}: ${error}"
    }
}

# ============================================================================
# HMAC (Hash-based Message Authentication Code)
# ============================================================================

sigh hmac(data, key, algorithm) {
    # Compute HMAC
    if algorithm == void {
        algorithm = "sha256"
    }

    attempt {
        exhale crypto_hmac(data, key, algorithm)
    } catch error {
        raise "HMAC failed (${algorithm}): ${error}"
    }
}

sigh hmac_sha256(data, key) {
    # HMAC-SHA256
    exhale hmac(data, key, "sha256")
}

sigh verify_hmac(data, key, expected_hmac, algorithm) {
    # Verify HMAC (constant-time comparison)
    if algorithm == void {
        algorithm = "sha256"
    }

    remember computed = hmac(data, key, algorithm)
    exhale constant_time_compare(computed, expected_hmac)
}

# ============================================================================
# ENCRYPTION / DECRYPTION
# ============================================================================

sigh encrypt_aes(plaintext, key, mode) {
    # Encrypt data using AES
    # mode: "CBC", "GCM", "CTR" (default: "GCM")

    if mode == void {
        mode = "GCM"
    }

    attempt {
        remember result = crypto_encrypt(plaintext, key, "AES", mode)
        exhale result
    } catch error {
        raise "AES encryption failed: ${error}"
    }
}

sigh decrypt_aes(ciphertext, key, mode) {
    # Decrypt data using AES
    if mode == void {
        mode = "GCM"
    }

    attempt {
        remember result = crypto_decrypt(ciphertext, key, "AES", mode)
        exhale result
    } catch error {
        raise "AES decryption failed: ${error}"
    }
}

sigh encrypt(plaintext, key, algorithm, mode) {
    # Generic encryption function
    if algorithm == void {
        algorithm = "AES"
    }

    if mode == void {
        mode = "GCM"
    }

    attempt {
        exhale crypto_encrypt(plaintext, key, algorithm, mode)
    } catch error {
        raise "Encryption failed (${algorithm}-${mode}): ${error}"
    }
}

sigh decrypt(ciphertext, key, algorithm, mode) {
    # Generic decryption function
    if algorithm == void {
        algorithm = "AES"
    }

    if mode == void {
        mode = "GCM"
    }

    attempt {
        exhale crypto_decrypt(ciphertext, key, algorithm, mode)
    } catch error {
        raise "Decryption failed (${algorithm}-${mode}): ${error}"
    }
}

# ============================================================================
# PASSWORD HASHING
# ============================================================================

sigh hash_password(password, salt) {
    # Hash password using PBKDF2
    if salt == void {
        salt = random_bytes(32)
    }

    attempt {
        remember iterations = 100000
        remember hash_result = pbkdf2(password, salt, iterations, 32, "sha256")

        remember result = {
            "hash": hash_result,
            "salt": salt,
            "iterations": iterations,
            "algorithm": "pbkdf2-sha256"
        }

        exhale result
    } catch error {
        raise "Password hashing failed: ${error}"
    }
}

sigh verify_password(password, hash_info) {
    # Verify password against hash
    attempt {
        remember computed = pbkdf2(
            password,
            hash_info["salt"],
            hash_info["iterations"],
            32,
            "sha256"
        )

        exhale constant_time_compare(computed, hash_info["hash"])
    } catch error {
        raise "Password verification failed: ${error}"
    }
}

# ============================================================================
# RANDOM GENERATION
# ============================================================================

sigh random() {
    # Generate random float between 0 and 1
    attempt {
        exhale crypto_random()
    } catch error {
        raise "Random generation failed: ${error}"
    }
}

sigh random_int(min_val, max_val) {
    # Generate random integer between min and max (inclusive)
    if max_val == void {
        max_val = min_val
        min_val = 0
    }

    remember range = max_val - min_val + 1
    remember rand_val = random()
    remember result = min_val + to_int(rand_val * range)

    # Ensure we don't exceed max due to rounding
    if result > max_val {
        result = max_val
    }

    exhale result
}

sigh random_bytes(length) {
    # Generate random bytes
    attempt {
        exhale crypto_random_bytes(length)
    } catch error {
        raise "Random bytes generation failed: ${error}"
    }
}

sigh random_string(length, charset) {
    # Generate random string
    if charset == void {
        charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    }

    remember charset_len = string_length(charset)
    remember result = ""
    remember i = 0

    while i < length {
        remember index = random_int(0, charset_len - 1)
        remember ch = char_at(charset, index)
        result = "${result}${ch}"
        i = i + 1
    }

    exhale result
}

sigh random_hex(length) {
    # Generate random hex string
    remember bytes = random_bytes(length)
    exhale bytes_to_hex(bytes)
}

sigh uuid() {
    # Generate UUID v4
    attempt {
        exhale crypto_uuid()
    } catch error {
        # Fallback: manual UUID generation
        remember hex = random_hex(16)

        # Format as UUID: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
        remember part1 = substring_str(hex, 0, 8)
        remember part2 = substring_str(hex, 8, 12)
        remember part3 = "4${substring_str(hex, 13, 16)}"  # Version 4
        remember part4 = substring_str(hex, 16, 20)
        remember part5 = substring_str(hex, 20, 32)

        exhale "${part1}-${part2}-${part3}-${part4}-${part5}"
    }
}

# ============================================================================
# ENCODING / DECODING
# ============================================================================

sigh base64_encode(data) {
    # Encode data as Base64
    attempt {
        exhale encode_base64(data)
    } catch error {
        raise "Base64 encoding failed: ${error}"
    }
}

sigh base64_decode(encoded) {
    # Decode Base64 data
    attempt {
        exhale decode_base64(encoded)
    } catch error {
        raise "Base64 decoding failed: ${error}"
    }
}

sigh hex_encode(data) {
    # Encode data as hexadecimal
    exhale bytes_to_hex(data)
}

sigh hex_decode(hex_str) {
    # Decode hexadecimal string
    exhale hex_to_bytes(hex_str)
}

sigh bytes_to_hex(data) {
    # Convert bytes to hexadecimal string
    remember result = ""
    remember i = 0
    remember len = string_length(data)

    while i < len {
        remember byte = char_code(char_at(data, i))
        remember hex = to_hex(byte)

        # Pad with zero if needed
        if string_length(hex) < 2 {
            hex = "0${hex}"
        }

        result = "${result}${hex}"
        i = i + 1
    }

    exhale result
}

sigh hex_to_bytes(hex_str) {
    # Convert hexadecimal string to bytes
    remember result = ""
    remember i = 0
    remember len = string_length(hex_str)

    while i < len {
        remember hex_pair = substring_str(hex_str, i, i + 2)
        remember byte_val = from_hex(hex_pair)
        result = "${result}${char_from_code(byte_val)}"
        i = i + 2
    }

    exhale result
}

# ============================================================================
# KEY DERIVATION
# ============================================================================

sigh pbkdf2(password, salt, iterations, key_length, hash_algo) {
    # PBKDF2 key derivation function
    if iterations == void {
        iterations = 100000
    }

    if key_length == void {
        key_length = 32
    }

    if hash_algo == void {
        hash_algo = "sha256"
    }

    attempt {
        exhale crypto_pbkdf2(password, salt, iterations, key_length, hash_algo)
    } catch error {
        raise "PBKDF2 failed: ${error}"
    }
}

sigh derive_key(password, salt, algorithm, params) {
    # Generic key derivation function
    if algorithm == void {
        algorithm = "pbkdf2"
    }

    if params == void {
        params = {
            "iterations": 100000,
            "key_length": 32,
            "hash": "sha256"
        }
    }

    attempt {
        if algorithm == "pbkdf2" {
            exhale pbkdf2(
                password,
                salt,
                params["iterations"],
                params["key_length"],
                params["hash"]
            )
        }

        raise "Unsupported key derivation algorithm: ${algorithm}"
    } catch error {
        raise "Key derivation failed: ${error}"
    }
}

# ============================================================================
# DIGITAL SIGNATURES (Placeholder for RSA/ECDSA)
# ============================================================================

sigh sign_data(data, private_key, algorithm) {
    # Sign data with private key
    if algorithm == void {
        algorithm = "RSA-SHA256"
    }

    attempt {
        exhale crypto_sign(data, private_key, algorithm)
    } catch error {
        raise "Signature failed (${algorithm}): ${error}"
    }
}

sigh verify_signature(data, signature, public_key, algorithm) {
    # Verify signature with public key
    if algorithm == void {
        algorithm = "RSA-SHA256"
    }

    attempt {
        exhale crypto_verify(data, signature, public_key, algorithm)
    } catch error {
        exhale no
    }
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

sigh constant_time_compare(a, b) {
    # Compare two strings in constant time (prevent timing attacks)
    remember len_a = string_length(a)
    remember len_b = string_length(b)

    # Always compare all bytes even if lengths differ
    remember result = len_a == len_b
    remember max_len = len_a

    if len_b > max_len {
        max_len = len_b
    }

    remember i = 0
    while i < max_len {
        remember char_a = ""
        remember char_b = ""

        if i < len_a {
            char_a = char_at(a, i)
        }

        if i < len_b {
            char_b = char_at(b, i)
        }

        if char_a != char_b {
            result = no
        }

        i = i + 1
    }

    exhale result
}

sigh secure_random_token(length) {
    # Generate secure random token (URL-safe)
    if length == void {
        length = 32
    }

    remember bytes = random_bytes(length)
    remember b64 = base64_encode(bytes)

    # Make URL-safe
    import { replace } from "strings.lament"
    b64 = replace(b64, "+", "-", -1)
    b64 = replace(b64, "/", "_", -1)
    b64 = replace(b64, "=", "", -1)

    # Trim to requested length
    exhale substring_str(b64, 0, length)
}

sigh checksum(data) {
    # Simple checksum (CRC32 equivalent using hash)
    remember full_hash = hash_md5(data)
    exhale substring_str(full_hash, 0, 8)
}

# ============================================================================
# ED25519 DIGITAL SIGNATURES
# ============================================================================

sigh ed25519_generate_keypair() {
    # Generate Ed25519 keypair
    # Returns: { public_key, private_key }

    attempt {
        exhale crypto_ed25519_generate_keypair()
    } catch error {
        raise "Failed to generate Ed25519 keypair: ${error}"
    }
}

sigh ed25519_sign(message, private_key) {
    # Sign message with Ed25519 private key

    attempt {
        exhale crypto_ed25519_sign(message, private_key)
    } catch error {
        raise "Ed25519 signing failed: ${error}"
    }
}

sigh ed25519_verify(message, signature, public_key) {
    # Verify Ed25519 signature

    attempt {
        exhale crypto_ed25519_verify(message, signature, public_key)
    } catch error {
        exhale no
    }
}

sigh ed25519_public_key_from_private(private_key) {
    # Derive public key from private key

    attempt {
        exhale crypto_ed25519_public_from_private(private_key)
    } catch error {
        raise "Failed to derive public key: ${error}"
    }
}

# ============================================================================
# GPG WRAPPER
# ============================================================================

sigh gpg_encrypt(data, recipient, armor) {
    # Encrypt data with GPG
    # recipient: email or key ID
    # armor: use ASCII armor (default: yes)

    if armor == void {
        armor = yes
    }

    import { run } from "process.lament"
    import { temp_file } from "files.lament"
    import { write_file, read_file, delete } from "files.lament"

    attempt {
        # Write data to temp file
        remember temp_in = temp_file("gpg_in_", ".txt")
        write_file(temp_in, data)

        remember temp_out = temp_file("gpg_out_", ".gpg")

        # Build GPG command
        remember armor_flag = ""
        if armor {
            armor_flag = "--armor"
        }

        remember result = run("gpg", [
            "--encrypt",
            armor_flag,
            "--recipient", recipient,
            "--output", temp_out,
            temp_in
        ], {})

        # Read encrypted data
        remember encrypted = read_file(temp_out)

        # Clean up
        delete(temp_in)
        delete(temp_out)

        exhale encrypted
    } catch error {
        raise "GPG encryption failed: ${error}"
    }
}

sigh gpg_decrypt(encrypted_data, passphrase) {
    # Decrypt GPG encrypted data

    import { run } from "process.lament"
    import { temp_file } from "files.lament"
    import { write_file, read_file, delete } from "files.lament"

    attempt {
        remember temp_in = temp_file("gpg_enc_", ".gpg")
        write_file(temp_in, encrypted_data)

        remember temp_out = temp_file("gpg_dec_", ".txt")

        remember args = [
            "--decrypt",
            "--output", temp_out,
            temp_in
        ]

        if passphrase != void {
            args = prepend_list(args, "--passphrase")
            args = prepend_list(args, passphrase)
            args = prepend_list(args, "--batch")
        }

        remember result = run("gpg", args, {})

        remember decrypted = read_file(temp_out)

        delete(temp_in)
        delete(temp_out)

        exhale decrypted
    } catch error {
        raise "GPG decryption failed: ${error}"
    }
}

sigh gpg_sign(data, key_id) {
    # Sign data with GPG

    import { run } from "process.lament"
    import { temp_file } from "files.lament"
    import { write_file, read_file, delete } from "files.lament"

    attempt {
        remember temp_in = temp_file("gpg_sign_in_", ".txt")
        write_file(temp_in, data)

        remember temp_out = temp_file("gpg_sign_out_", ".sig")

        remember args = ["--sign", "--output", temp_out, temp_in]

        if key_id != void {
            args = prepend_list(args, "--local-user")
            args = prepend_list(args, key_id)
        }

        remember result = run("gpg", args, {})

        remember signature = read_file(temp_out)

        delete(temp_in)
        delete(temp_out)

        exhale signature
    } catch error {
        raise "GPG signing failed: ${error}"
    }
}

sigh gpg_verify(data, signature) {
    # Verify GPG signature

    import { exec } from "process.lament"
    import { temp_file } from "files.lament"
    import { write_file, delete } from "files.lament"

    attempt {
        remember temp_data = temp_file("gpg_data_", ".txt")
        remember temp_sig = temp_file("gpg_sig_", ".sig")

        write_file(temp_data, data)
        write_file(temp_sig, signature)

        remember result = exec("gpg", ["--verify", temp_sig, temp_data], {})

        delete(temp_data)
        delete(temp_sig)

        # GPG returns 0 on success
        exhale result["exit_code"] == 0
    } catch error {
        exhale no
    }
}

# ============================================================================
# ADVANCED KEY DERIVATION
# ============================================================================

sigh scrypt(password, salt, N, r, p, key_length) {
    # Scrypt key derivation function
    # N: CPU/memory cost parameter
    # r: block size parameter
    # p: parallelization parameter

    if N == void {
        N = 16384
    }

    if r == void {
        r = 8
    }

    if p == void {
        p = 1
    }

    if key_length == void {
        key_length = 32
    }

    attempt {
        exhale crypto_scrypt(password, salt, N, r, p, key_length)
    } catch error {
        raise "Scrypt failed: ${error}"
    }
}

sigh argon2(password, salt, type_variant, time_cost, memory_cost, parallelism) {
    # Argon2 key derivation function
    # type_variant: "d", "i", or "id" (default: "id")

    if type_variant == void {
        type_variant = "id"
    }

    if time_cost == void {
        time_cost = 3
    }

    if memory_cost == void {
        memory_cost = 4096  # KiB
    }

    if parallelism == void {
        parallelism = 1
    }

    attempt {
        exhale crypto_argon2(password, salt, type_variant, time_cost, memory_cost, parallelism)
    } catch error {
        raise "Argon2 failed: ${error}"
    }
}

sigh hkdf(input_key, salt, info, length, hash_algo) {
    # HKDF (HMAC-based Extract-and-Expand Key Derivation Function)

    if hash_algo == void {
        hash_algo = "sha256"
    }

    if length == void {
        length = 32
    }

    attempt {
        exhale crypto_hkdf(input_key, salt, info, length, hash_algo)
    } catch error {
        raise "HKDF failed: ${error}"
    }
}

# ============================================================================
# ENHANCED SECURE RANDOM
# ============================================================================

sigh secure_random_bytes(length) {
    # Generate cryptographically secure random bytes
    # Uses OS-level entropy source (e.g., /dev/urandom)

    attempt {
        exhale crypto_secure_random_bytes(length)
    } catch error {
        # Fallback to regular random
        exhale random_bytes(length)
    }
}

sigh secure_random_int(min_val, max_val) {
    # Generate cryptographically secure random integer

    if max_val == void {
        max_val = min_val
        min_val = 0
    }

    remember range = max_val - min_val + 1

    # Use rejection sampling to avoid modulo bias
    remember bytes_needed = 4  # 32 bits
    remember max_valid = 4294967296 - (4294967296 % range)

    remember attempts = 0
    while attempts < 100 {
        remember random_bytes = secure_random_bytes(bytes_needed)

        # Convert to integer
        remember value = bytes_to_int(random_bytes)

        if value < max_valid {
            exhale min_val + (value % range)
        }

        attempts = attempts + 1
    }

    # Fallback
    exhale random_int(min_val, max_val)
}

sigh secure_random_string(length, charset) {
    # Generate cryptographically secure random string

    if charset == void {
        charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    }

    remember charset_len = string_length(charset)
    remember result = ""
    remember i = 0

    while i < length {
        remember index = secure_random_int(0, charset_len - 1)
        remember ch = char_at(charset, index)
        result = "${result}${ch}"
        i = i + 1
    }

    exhale result
}

sigh random_passphrase(num_words, separator) {
    # Generate random passphrase using word list

    if num_words == void {
        num_words = 4
    }

    if separator == void {
        separator = "-"
    }

    # Simple word list (in real implementation, use a larger list)
    remember words = [
        "alpha", "bravo", "charlie", "delta", "echo", "foxtrot",
        "golf", "hotel", "india", "juliet", "kilo", "lima",
        "mike", "november", "oscar", "papa", "quebec", "romeo",
        "sierra", "tango", "uniform", "victor", "whiskey", "xray",
        "yankee", "zulu"
    ]

    remember word_count = length_of(words)
    remember passphrase = []
    remember i = 0

    while i < num_words {
        remember index = secure_random_int(0, word_count - 1)
        passphrase = append_to_list(passphrase, words[index])
        i = i + 1
    }

    import { join } from "strings.lament"
    exhale join(passphrase, separator)
}

# ============================================================================
# CRYPTOGRAPHIC UTILITIES
# ============================================================================

sigh constant_time_equals(a, b) {
    # Constant-time string comparison (alias for clarity)
    exhale constant_time_compare(a, b)
}

sigh secure_zero(data) {
    # Securely zero out sensitive data in memory
    # Note: This is a placeholder - actual implementation would need
    # low-level memory operations

    attempt {
        crypto_secure_zero(data)
        exhale yes
    } catch error {
        # Best effort: overwrite with zeros
        remember len = string_length(data)
        remember zeros = ""
        remember i = 0
        while i < len {
            zeros = "${zeros}\x00"
            i = i + 1
        }
        exhale yes
    }
}

sigh timing_safe_compare(a, b) {
    # Timing-safe comparison (alias)
    exhale constant_time_compare(a, b)
}

# ============================================================================
# CERTIFICATE OPERATIONS
# ============================================================================

sigh load_certificate(path) {
    # Load X.509 certificate from PEM file

    import { read_file } from "files.lament"

    attempt {
        remember pem_data = read_file(path)
        exhale parse_certificate(pem_data)
    } catch error {
        raise "Failed to load certificate from ${path}: ${error}"
    }
}

sigh parse_certificate(pem_data) {
    # Parse X.509 certificate from PEM format

    attempt {
        exhale crypto_parse_certificate(pem_data)
    } catch error {
        raise "Failed to parse certificate: ${error}"
    }
}

sigh verify_certificate_chain(cert, ca_certs) {
    # Verify certificate chain

    attempt {
        exhale crypto_verify_cert_chain(cert, ca_certs)
    } catch error {
        exhale no
    }
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

sigh bytes_to_int(bytes) {
    # Convert bytes to integer (big-endian)
    remember result = 0
    remember i = 0
    remember len = string_length(bytes)

    while i < len {
        remember byte = char_code(char_at(bytes, i))
        result = (result * 256) + byte
        i = i + 1
    }

    exhale result
}

sigh prepend_list(list, item) {
    remember result = [item]
    for existing in list {
        result = push(result, existing)
    }
    exhale result
}

sigh append_to_list(list, item) {
    remember result = []
    for existing in list {
        result = push(result, existing)
    }
    result = push(result, item)
    exhale result
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

sigh substring_str(text, start, end) {
    exhale substring(text, start, end)
}

sigh to_hex(number) {
    # Convert number to hex string
    if number == 0 {
        exhale "0"
    }

    remember hex_chars = "0123456789abcdef"
    remember result = ""
    remember n = number

    while n > 0 {
        remember digit = n % 16
        result = "${char_at(hex_chars, digit)}${result}"
        n = n / 16
    }

    exhale result
}

sigh from_hex(hex_str) {
    # Convert hex string to number
    remember result = 0
    remember i = 0
    remember len = string_length(hex_str)

    while i < len {
        remember ch = lower_char(char_at(hex_str, i))
        remember digit = 0

        remember code = char_code(ch)
        if code >= 48 and code <= 57 {
            # 0-9
            digit = code - 48
        } else {
            if code >= 97 and code <= 102 {
                # a-f
                digit = code - 97 + 10
            }
        }

        result = result * 16 + digit
        i = i + 1
    }

    exhale result
}

sigh lower_char(ch) {
    remember code = char_code(ch)
    if code >= 65 and code <= 90 {
        exhale char_from_code(code + 32)
    }
    exhale ch
}

# ============================================================================
# EXPORT PUBLIC API
# ============================================================================

expose {
    hash_md5, hash_sha1, hash_sha256, hash_sha512, hash, hash_file,
    hmac, hmac_sha256, verify_hmac,
    encrypt_aes, decrypt_aes, encrypt, decrypt,
    hash_password, verify_password,
    random, random_int, random_bytes, random_string, random_hex, uuid,
    base64_encode, base64_decode, hex_encode, hex_decode,
    bytes_to_hex, hex_to_bytes,
    pbkdf2, derive_key,
    sign_data, verify_signature,
    constant_time_compare, secure_random_token, checksum,
    ed25519_generate_keypair, ed25519_sign, ed25519_verify, ed25519_public_key_from_private,
    gpg_encrypt, gpg_decrypt, gpg_sign, gpg_verify,
    scrypt, argon2, hkdf,
    secure_random_bytes, secure_random_int, secure_random_string, random_passphrase,
    constant_time_equals, secure_zero, timing_safe_compare,
    load_certificate, parse_certificate, verify_certificate_chain
}
