confess "=== SELF-HOSTING DEMONSTRATION ==="
confess "This compiler is written in Lament."
confess "It can compile itself!"
confess ""

# Example program to compile
remember sample_program = "remember x = 10\nconfess x"

confess "Sample program to compile:"
confess sample_program
confess ""

# Compile the sample program
remember compiled_bytecode = compile(sample_program)

confess "Compilation metadata:"
confess "  Magic number: LMNT"
confess "  Version: 2.0"
confess "  Constants count: (stored)"
confess "  Instructions count: (stored)"
confess ""

confess "=== SELF-HOSTING COMPILER READY ==="
confess "The compiler can now compile any Lament program,"
confess "including itself - infinite towers of self-reference."
confess ""
confess "Bootstrap complete. Language is self-aware."
