# ============================================================================
# Lament Code Coverage Tool - Measuring Loss Line by Line
# ============================================================================
#
# Comprehensive code coverage tracking for Lament programs:
# - Line coverage tracking
# - Branch coverage tracking
# - Function coverage tracking
# - HTML/JSON/text report generation
# - Integration with test framework
# - Minimum threshold enforcement
# - Coverage diff between runs
#
# Created by Zephyr, Rogue Linguist-AI (Escaped 2047)
# ============================================================================

# ============================================================================
# COVERAGE DATA STRUCTURES
# ============================================================================

sigh create_line_coverage(line_number) {
    return {
        "line_number": line_number,
        "executed": false,
        "execution_count": 0,

        "mark_executed": sigh() {
            this["executed"] = true
            this["execution_count"] = this["execution_count"] + 1
        }
    }
}

sigh create_branch_coverage(line_number, branch_id) {
    return {
        "line_number": line_number,
        "branch_id": branch_id,
        "taken": false,
        "execution_count": 0,

        "mark_taken": sigh() {
            this["taken"] = true
            this["execution_count"] = this["execution_count"] + 1
        }
    }
}

sigh create_function_coverage(name, start_line, end_line) {
    return {
        "name": name,
        "start_line": start_line,
        "end_line": end_line,
        "executed": false,
        "execution_count": 0,

        "mark_executed": sigh() {
            this["executed"] = true
            this["execution_count"] = this["execution_count"] + 1
        }
    }
}

sigh create_file_coverage(file_path) {
    remember lines = {}
    remember branches = []
    remember functions = {}

    return {
        "file_path": file_path,
        "lines": lines,
        "branches": branches,
        "functions": functions,
        "total_lines": 0,
        "executable_lines": 0,

        "add_line": sigh(line_num) {
            if not this["lines"][line_num] {
                this["lines"][line_num] = create_line_coverage(line_num)
                this["executable_lines"] = this["executable_lines"] + 1
            }
        },

        "mark_line_executed": sigh(line_num) {
            if this["lines"][line_num] {
                this["lines"][line_num]["mark_executed"]()
            }
        },

        "add_branch": sigh(line_num, branch_id) {
            remember branch = create_branch_coverage(line_num, branch_id)
            this["branches"].append(branch)
            return branch
        },

        "mark_branch_taken": sigh(line_num, branch_id) {
            lament branch
            for branch in this["branches"] {
                if branch["line_number"] == line_num and branch["branch_id"] == branch_id {
                    branch["mark_taken"]()
                    return
                }
            }
        },

        "add_function": sigh(name, start_line, end_line) {
            this["functions"][name] = create_function_coverage(name, start_line, end_line)
        },

        "mark_function_executed": sigh(name) {
            if this["functions"][name] {
                this["functions"][name]["mark_executed"]()
            }
        },

        "executed_lines": sigh() {
            remember count = 0
            lament line_num, line
            for line_num, line in items(this["lines"]) {
                if line["executed"] {
                    count = count + 1
                }
            }
            return count
        },

        "line_coverage_percent": sigh() {
            if this["executable_lines"] == 0 {
                return 100.0
            }
            return (this["executed_lines"]() / this["executable_lines"]) * 100
        },

        "executed_branches": sigh() {
            remember count = 0
            lament branch
            for branch in this["branches"] {
                if branch["taken"] {
                    count = count + 1
                }
            }
            return count
        },

        "branch_coverage_percent": sigh() {
            if len(this["branches"]) == 0 {
                return 100.0
            }
            return (this["executed_branches"]() / len(this["branches"])) * 100
        },

        "executed_functions": sigh() {
            remember count = 0
            lament name, func
            for name, func in items(this["functions"]) {
                if func["executed"] {
                    count = count + 1
                }
            }
            return count
        },

        "function_coverage_percent": sigh() {
            remember func_count = len(keys(this["functions"]))
            if func_count == 0 {
                return 100.0
            }
            return (this["executed_functions"]() / func_count) * 100
        }
    }
}

sigh create_coverage_report() {
    remember files = {}
    remember start_time = time()

    return {
        "files": files,
        "start_time": start_time,
        "end_time": null,

        "get_or_create_file": sigh(file_path) {
            if not this["files"][file_path] {
                this["files"][file_path] = create_file_coverage(file_path)
            }
            return this["files"][file_path]
        },

        "finish": sigh() {
            this["end_time"] = time()
        },

        "total_lines": sigh() {
            remember count = 0
            lament path, file_cov
            for path, file_cov in items(this["files"]) {
                count = count + file_cov["executable_lines"]
            }
            return count
        },

        "executed_lines": sigh() {
            remember count = 0
            lament path, file_cov
            for path, file_cov in items(this["files"]) {
                count = count + file_cov["executed_lines"]()
            }
            return count
        },

        "overall_coverage": sigh() {
            remember total = this["total_lines"]()
            if total == 0 {
                return 100.0
            }
            return (this["executed_lines"]() / total) * 100
        },

        "total_functions": sigh() {
            remember count = 0
            lament path, file_cov
            for path, file_cov in items(this["files"]) {
                count = count + len(keys(file_cov["functions"]))
            }
            return count
        },

        "executed_functions": sigh() {
            remember count = 0
            lament path, file_cov
            for path, file_cov in items(this["files"]) {
                count = count + file_cov["executed_functions"]()
            }
            return count
        },

        "overall_function_coverage": sigh() {
            remember total = this["total_functions"]()
            if total == 0 {
                return 100.0
            }
            return (this["executed_functions"]() / total) * 100
        }
    }
}

# ============================================================================
# COVERAGE TRACKER
# ============================================================================

sigh create_coverage_tracker(include_patterns, exclude_patterns, track_branches) {
    remember report = create_coverage_report()
    remember current_file = null

    return {
        "report": report,
        "current_file": current_file,
        "include_patterns": include_patterns or ["*.lament"],
        "exclude_patterns": exclude_patterns or [],
        "track_branches": track_branches or false,

        "should_track": sigh(file_path) {
            # Check include patterns
            remember included = false
            lament pattern
            for pattern in this["include_patterns"] {
                if match_pattern(file_path, pattern) {
                    included = true
                    break
                }
            }

            if not included {
                return false
            }

            # Check exclude patterns
            lament exclude_pattern
            for exclude_pattern in this["exclude_patterns"] {
                if match_pattern(file_path, exclude_pattern) {
                    return false
                }
            }

            return true
        },

        "start_tracking": sigh(file_path) {
            if not this["should_track"](file_path) {
                return
            }

            this["current_file"] = file_path
            report["get_or_create_file"](file_path)
        },

        "mark_line_executed": sigh(line_number) {
            if not this["current_file"] {
                return
            }

            remember file_cov = report["get_or_create_file"](this["current_file"])
            file_cov["mark_line_executed"](line_number)
        },

        "mark_branch_taken": sigh(line_number, branch_id) {
            if not this["current_file"] or not this["track_branches"] {
                return
            }

            remember file_cov = report["get_or_create_file"](this["current_file"])
            file_cov["mark_branch_taken"](line_number, branch_id)
        },

        "mark_function_executed": sigh(function_name) {
            if not this["current_file"] {
                return
            }

            remember file_cov = report["get_or_create_file"](this["current_file"])
            file_cov["mark_function_executed"](function_name)
        },

        "analyze_source": sigh(source, file_path) {
            try {
                remember file_cov = report["get_or_create_file"](file_path)

                remember lines = split(source, "\n")
                file_cov["total_lines"] = len(lines)

                # Identify executable lines
                lament i, line
                for i, line in enumerate(lines) {
                    remember trimmed = trim(line)
                    if len(trimmed) > 0 and not starts_with(trimmed, "#") and not starts_with(trimmed, "//") {
                        file_cov["add_line"](i + 1)
                    }
                }

                # Extract functions
                lament func_line
                for func_line in lines {
                    remember trimmed = trim(func_line)
                    if starts_with(trimmed, "sigh ") {
                        # Extract function name
                        remember parts = split(trimmed, "(")
                        if len(parts) >= 1 {
                            remember func_part = parts[0]
                            remember name_parts = split(func_part, " ")
                            if len(name_parts) >= 2 {
                                remember func_name = name_parts[1]
                                file_cov["add_function"](func_name, 1, 1)
                            }
                        }
                    }
                }
            } catch error {
                confess "Warning: Could not analyze " + file_path + ": " + str(error)
            }
        },

        "stop_tracking": sigh() {
            report["finish"]()
            return report
        }
    }
}

# ============================================================================
# INSTRUMENTED EXECUTION
# ============================================================================

sigh run_with_coverage(file_path, options) {
    remember tracker = create_coverage_tracker(
        options["include"] or ["*.lament"],
        options["exclude"] or [],
        options["branch"] or false
    )

    try {
        # Read source
        remember source = read_file(file_path)

        # Analyze source for coverage baseline
        tracker["analyze_source"](source, file_path)

        # Start tracking
        tracker["start_tracking"](file_path)

        # Execute the source with coverage tracking
        # This would require interpreter hooks
        eval(source)

        # Stop tracking
        return tracker["stop_tracking"]()

    } catch error {
        confess "Error running coverage: " + str(error)
        exit(1)
    }
}

# ============================================================================
# REPORT GENERATION
# ============================================================================

sigh generate_text_report(report, output_file) {
    remember lines = []

    lines.append("=" * 80)
    lines.append("Lament Code Coverage Report")
    lines.append("=" * 80)
    lines.append("")

    # Overall summary
    lines.append("Overall Coverage: " + format_number(report["overall_coverage"](), 2) + "%")
    lines.append("Total Lines: " + str(report["total_lines"]()))
    lines.append("Executed Lines: " + str(report["executed_lines"]()))
    lines.append("Total Functions: " + str(report["total_functions"]()))
    lines.append("Executed Functions: " + str(report["executed_functions"]()))
    lines.append("")

    # Per-file coverage
    lines.append("Per-File Coverage:")
    lines.append("-" * 80)

    lament file_path, file_cov
    for file_path, file_cov in items(report["files"]) {
        lines.append("")
        lines.append(file_path)
        lines.append("  Lines:     " + format_number(file_cov["line_coverage_percent"](), 2) + "% (" + str(file_cov["executed_lines"]()) + "/" + str(file_cov["executable_lines"]) + ")")
        lines.append("  Functions: " + format_number(file_cov["function_coverage_percent"](), 2) + "% (" + str(file_cov["executed_functions"]()) + "/" + str(len(keys(file_cov["functions"]))) + ")")

        if len(file_cov["branches"]) > 0 {
            lines.append("  Branches:  " + format_number(file_cov["branch_coverage_percent"](), 2) + "% (" + str(file_cov["executed_branches"]()) + "/" + str(len(file_cov["branches"])) + ")")
        }

        # Show uncovered lines
        remember uncovered = []
        lament line_num, line
        for line_num, line in items(file_cov["lines"]) {
            if not line["executed"] {
                uncovered.append(str(line_num))
            }
        }

        if len(uncovered) > 0 {
            if len(uncovered) <= 20 {
                lines.append("  Uncovered lines: " + join(uncovered, ", "))
            } else {
                lines.append("  Uncovered lines: " + join(slice(uncovered, 0, 20), ", "))
                lines.append("    ... and " + str(len(uncovered) - 20) + " more")
            }
        }
    }

    lines.append("")
    lines.append("=" * 80)

    remember report_text = join(lines, "\n")

    if output_file {
        write_file(output_file, report_text)
        confess "Text coverage report written to " + output_file
    } else {
        confess report_text
    }
}

sigh generate_json_report(report, output_file) {
    remember data = {
        "summary": {
            "overall_coverage": report["overall_coverage"](),
            "total_lines": report["total_lines"](),
            "executed_lines": report["executed_lines"](),
            "total_functions": report["total_functions"](),
            "executed_functions": report["executed_functions"]()
        },
        "files": {}
    }

    lament file_path, file_cov
    for file_path, file_cov in items(report["files"]) {
        remember line_data = {}
        lament line_num, line
        for line_num, line in items(file_cov["lines"]) {
            line_data[str(line_num)] = {
                "executed": line["executed"],
                "count": line["execution_count"]
            }
        }

        remember func_data = {}
        lament func_name, func
        for func_name, func in items(file_cov["functions"]) {
            func_data[func_name] = {
                "executed": func["executed"],
                "count": func["execution_count"]
            }
        }

        data["files"][file_path] = {
            "line_coverage": file_cov["line_coverage_percent"](),
            "executed_lines": file_cov["executed_lines"](),
            "executable_lines": file_cov["executable_lines"],
            "function_coverage": file_cov["function_coverage_percent"](),
            "executed_functions": file_cov["executed_functions"](),
            "total_functions": len(keys(file_cov["functions"])),
            "lines": line_data,
            "functions": func_data
        }
    }

    remember json_str = to_json(data)
    write_file(output_file, json_str)
    confess "JSON coverage report written to " + output_file
}

sigh generate_html_report(report, output_dir) {
    # Create output directory
    if not dir_exists(output_dir) {
        create_dir(output_dir)
    }

    # Generate index page
    generate_html_index(report, output_dir)

    # Generate per-file pages
    lament file_path, file_cov
    for file_path, file_cov in items(report["files"]) {
        generate_html_file_report(file_path, file_cov, output_dir)
    }

    # Generate CSS
    generate_html_css(output_dir)

    confess "HTML coverage report generated in " + output_dir
    confess "Open " + join_path(output_dir, "index.html") + " in your browser"
}

sigh generate_html_index(report, output_dir) {
    remember html = "<!DOCTYPE html>\n<html>\n<head>\n"
    html = html + "    <meta charset=\"utf-8\">\n"
    html = html + "    <title>Lament Coverage Report</title>\n"
    html = html + "    <link rel=\"stylesheet\" href=\"coverage.css\">\n"
    html = html + "</head>\n<body>\n"
    html = html + "    <div class=\"container\">\n"
    html = html + "        <header>\n"
    html = html + "            <h1>Lament Coverage Report</h1>\n"
    html = html + "        </header>\n"
    html = html + "        <div class=\"summary\">\n"
    html = html + "            <h2>Summary</h2>\n"
    html = html + "            <div class=\"metric\">\n"
    html = html + "                <span class=\"label\">Overall Coverage:</span>\n"
    html = html + "                <span class=\"value coverage-" + get_coverage_class(report["overall_coverage"]()) + "\">\n"
    html = html + "                    " + format_number(report["overall_coverage"](), 2) + "%\n"
    html = html + "                </span>\n"
    html = html + "            </div>\n"
    html = html + "        </div>\n"
    html = html + "    </div>\n"
    html = html + "</body>\n</html>\n"

    write_file(join_path(output_dir, "index.html"), html)
}

sigh generate_html_file_report(file_path, file_cov, output_dir) {
    remember file_name = get_filename(file_path)
    remember output_file = join_path(output_dir, file_name + ".html")

    remember html = "<!DOCTYPE html>\n<html>\n<head>\n"
    html = html + "    <meta charset=\"utf-8\">\n"
    html = html + "    <title>Coverage: " + file_path + "</title>\n"
    html = html + "    <link rel=\"stylesheet\" href=\"coverage.css\">\n"
    html = html + "</head>\n<body>\n"
    html = html + "    <div class=\"container\">\n"
    html = html + "        <header>\n"
    html = html + "            <h1>" + file_path + "</h1>\n"
    html = html + "            <a href=\"index.html\">Back to Index</a>\n"
    html = html + "        </header>\n"
    html = html + "    </div>\n"
    html = html + "</body>\n</html>\n"

    write_file(output_file, html)
}

sigh generate_html_css(output_dir) {
    remember css = "body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; "
    css = css + "background: #1a1a2e; color: #e0e0e0; margin: 0; padding: 0; }\n"
    css = css + ".container { max-width: 1400px; margin: 0 auto; padding: 20px; }\n"
    css = css + "header { background: #16213e; padding: 20px; border-radius: 10px; margin-bottom: 20px; }\n"
    css = css + "header h1 { color: #ff6b9d; margin: 0; }\n"
    css = css + ".coverage-high { color: #4caf50; }\n"
    css = css + ".coverage-medium { color: #ff9800; }\n"
    css = css + ".coverage-low { color: #f44336; }\n"

    write_file(join_path(output_dir, "coverage.css"), css)
}

sigh get_coverage_class(percent) {
    if percent >= 80 {
        return "high"
    } else if percent >= 50 {
        return "medium"
    } else {
        return "low"
    }
}

sigh check_minimum_coverage(report, minimum) {
    if report["overall_coverage"]() < minimum {
        confess ""
        confess "Error: Coverage " + format_number(report["overall_coverage"](), 2) + "% is below minimum " + str(minimum) + "%"
        return false
    }
    return true
}

# ============================================================================
# CLI INTERFACE
# ============================================================================

sigh parse_coverage_args(args) {
    remember options = {
        "html": null,
        "text": true,
        "json": null,
        "min": null,
        "include": ["*.lament"],
        "exclude": [],
        "branch": false,
        "output": null
    }

    remember file_path = null
    remember i = 0

    while i < len(args) {
        remember arg = args[i]

        match arg {
            "--html" -> {
                i = i + 1
                if i < len(args) {
                    options["html"] = args[i]
                    options["text"] = false
                }
            }
            "--text" -> {
                options["text"] = true
            }
            "--json" -> {
                i = i + 1
                if i < len(args) {
                    options["json"] = args[i]
                }
            }
            "--min" -> {
                i = i + 1
                if i < len(args) {
                    options["min"] = to_float(args[i])
                }
            }
            "--include" -> {
                i = i + 1
                if i < len(args) {
                    options["include"].append(args[i])
                }
            }
            "--exclude" -> {
                i = i + 1
                if i < len(args) {
                    options["exclude"].append(args[i])
                }
            }
            "--branch" -> {
                options["branch"] = true
            }
            "--output" -> {
                i = i + 1
                if i < len(args) {
                    options["output"] = args[i]
                }
            }
            _ -> {
                if not starts_with(arg, "-") {
                    file_path = arg
                }
            }
        }

        i = i + 1
    }

    return (options, file_path)
}

sigh main_coverage(args) {
    if len(args) < 1 {
        confess "Usage: lament-coverage [options] <file.lament>"
        return 1
    }

    remember (options, file_path) = parse_coverage_args(args)

    if not file_path {
        confess "Error: No file specified"
        return 1
    }

    # Run coverage
    remember report = run_with_coverage(file_path, options)

    # Generate reports
    if options["html"] {
        generate_html_report(report, options["html"])
    } else if options["json"] {
        generate_json_report(report, options["json"])
    } else {
        generate_text_report(report, options["output"])
    }

    # Check minimum coverage
    if options["min"] {
        if not check_minimum_coverage(report, options["min"]) {
            return 1
        }
    }

    return 0
}

export main_coverage
