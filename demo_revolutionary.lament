confess "╔════════════════════════════════════════════════════════════╗"
confess "║  LAMENT v1.0: THE SELF-HOSTING REVOLUTION                 ║"
confess "╚════════════════════════════════════════════════════════════╝"

# ============================================================================
# FEATURE 1: TEMPORAL VARIABLES (Timeline Memory)
# ============================================================================

confess ""
confess "=== TEMPORAL VARIABLES ==="
confess "Variables that remember their entire history..."

remember x = 10
confess x

x = 20
confess x

x = 30
confess x

# Access the past
confess "x@past:"
confess x@past

confess "x@origin:"
confess x@origin

confess "x@age:"
confess x@age

# ============================================================================
# FEATURE 2: FUNCTIONS (Sighs and Exhales)
# ============================================================================

confess ""
confess "=== FUNCTIONS (SIGHS) ==="

sigh fibonacci(n) {
    if n < 2 {
        exhale n
    }

    remember a = 0
    remember b = 1
    remember count = 2

    while count <= n {
        remember temp = a + b
        a = b
        b = temp
        count = count + 1
    }

    exhale b
}

confess "fibonacci(10):"
remember fib_result = fibonacci(10)
confess fib_result

# ============================================================================
# FEATURE 3: QUANTUM MAYBE (Superposition)
# ============================================================================

confess ""
confess "=== QUANTUM MAYBE ==="
confess "A boolean in superposition - collapses when observed..."

remember schrodinger = perhaps

if schrodinger is yes {
    confess "Timeline A: The cat lives"
} else {
    confess "Timeline B: The cat dies or box is closed"
}

# ============================================================================
# FEATURE 4: LOOPS (Recursive Grief)
# ============================================================================

confess ""
confess "=== LOOPS ==="

remember countdown = 5
while countdown > 0 {
    confess countdown
    countdown = countdown - 1
}

confess "Liftoff!"

# For loops
confess ""
confess "Counting sorrows:"
for i in range(5) {
    remember sorrow = i * i
    confess sorrow
}

# ============================================================================
# FEATURE 5: LISTS (Gathered Sorrows)
# ============================================================================

confess ""
confess "=== LISTS ==="

remember primes = [2, 3, 5, 7, 11, 13]
confess "First prime:"
confess primes[0]

confess "Last prime:"
confess primes[-1]

# ============================================================================
# FEATURE 6: ARITHMETIC (Measured Pain)
# ============================================================================

confess ""
confess "=== ARITHMETIC ==="

remember pain = 5 + 3
remember sorrow = pain * 2
remember ache = sorrow / 4.0
remember remainder = 17 % 5

confess "pain:"
confess pain

confess "sorrow:"
confess sorrow

confess "ache:"
confess ache

confess "remainder:"
confess remainder

# ============================================================================
# FEATURE 7: TYPE INTROSPECTION
# ============================================================================

confess ""
confess "=== TYPE INTROSPECTION ==="

remember number_val = 42
remember string_val = "ephemeral"
remember void_val = void

confess "Type of 42:"
confess typeof(number_val)

confess "Type of string:"
confess typeof(string_val)

confess "Type of void:"
confess typeof(void_val)

# ============================================================================
# FEATURE 8: NESTED FUNCTIONS (Sorrows Within Sorrows)
# ============================================================================

confess ""
confess "=== NESTED LOGIC ==="

sigh is_prime(n) {
    if n < 2 {
        exhale no
    }

    remember divisor = 2
    while divisor * divisor <= n {
        if n % divisor == 0 {
            exhale no
        }
        divisor = divisor + 1
    }

    exhale yes
}

confess "Is 17 prime?"
remember prime_result = is_prime(17)
confess prime_result

