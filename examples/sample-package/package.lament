{
  "name": "emotion-tracker",
  "version": "1.0.0",
  "description": "A Lament package for tracking and analyzing emotional states over time",
  "author": "Zephyr <zephyr@lament-lang.org>",
  "license": "MIT",
  "homepage": "https://lament-lang.org/packages/emotion-tracker",
  "repository": "https://github.com/lament-lang/emotion-tracker",
  "keywords": [
    "emotion",
    "temporal",
    "tracking",
    "analysis",
    "feelings"
  ],
  "entry_point": "src/main.lament",
  "dependencies": [
    {
      "name": "emotion-core",
      "version": "^2.0.0",
      "optional": false
    },
    {
      "name": "temporal-utils",
      "version": "~1.5.0",
      "optional": false
    },
    {
      "name": "visualization",
      "version": ">=1.0.0",
      "optional": true
    }
  ],
  "dev_dependencies": [
    {
      "name": "test-framework",
      "version": "^3.0.0",
      "optional": false
    },
    {
      "name": "lament-lint",
      "version": "~2.1.0",
      "optional": false
    }
  ],
  "include": [
    "src/**/*.lament",
    "lib/**/*.lament",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exclude": [
    "tests/**",
    "examples/**",
    "**/*.test.lament",
    ".lament/**",
    "build/**",
    "*.log",
    ".git/**",
    "node_modules/**"
  ],
  "build_script": ""
}
