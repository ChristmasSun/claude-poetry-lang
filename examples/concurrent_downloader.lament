# ============================================================================
# LAMENT CONCURRENT DOWNLOADER - Actor-Based Parallelism
# ============================================================================
# Demonstrates Lament's superiority over Python for concurrency:
# - Actor model for message-passing parallelism
# - Work-stealing scheduler for load balancing
# - Channels for inter-actor communication
# - Progress tracking with temporal variables
# - Automatic error recovery with supervision
# ============================================================================

confess "⚡ Lament Concurrent Downloader - Actor-Based Parallelism ⚡"
confess ""

# ============================================================================
# DOWNLOAD TASK
# ============================================================================

class DownloadTask {
    sigh init(url, destination) {
        this.url = url
        this.destination = destination
        this.status = "pending"
        this.progress = 0.0
        this.size = 0
        this.downloaded = 0
        this.error = void
        this.start_time = 0
        this.end_time = 0
    }

    sigh get_progress_percent() {
        if this.size > 0 {
            exhale (this.downloaded / this.size) * 100.0
        }
        exhale 0.0
    }

    sigh get_speed() {
        # Calculate download speed (bytes per second)
        if this.end_time > this.start_time {
            remember duration = this.end_time - this.start_time
            exhale this.downloaded / duration
        }
        exhale 0.0
    }

    sigh is_complete() {
        exhale this.status == "completed"
    }

    sigh is_failed() {
        exhale this.status == "failed"
    }
}

# ============================================================================
# DOWNLOADER ACTOR - Individual Worker
# ============================================================================

class DownloaderActor {
    sigh init(name) {
        this.name = name
        this.status = "idle"
        this.current_task = void
        this.tasks_completed = 0
        this.tasks_failed = 0
        this.total_bytes_downloaded = 0
    }

    sigh download(task) {
        this.status = "downloading"
        this.current_task = task

        confess "🔽 ${this.name} starting download: ${task.url}"

        attempt {
            # Simulate download process
            task.status = "downloading"
            task.start_time = this.tasks_completed * 10  # Simulated time

            # Simulate file size
            task.size = 1024 * 1024 * (this.tasks_completed + 1)  # Variable sizes

            # Simulate download in chunks
            remember chunks = 10
            remember i = 0
            while i < chunks {
                remember chunk_size = task.size / chunks
                task.downloaded = task.downloaded + chunk_size
                task.progress = this.get_progress_percent()

                # Simulate progress callback
                if i % 3 == 0 {
                    remember progress = task.get_progress_percent()
                    confess "   ${this.name}: ${task.url} - ${progress}% complete"
                }

                i = i + 1
            }

            task.end_time = task.start_time + 10
            task.status = "completed"

            this.tasks_completed = this.tasks_completed + 1
            this.total_bytes_downloaded = this.total_bytes_downloaded + task.size

            confess "✅ ${this.name} completed: ${task.url}"

        } catch download_error {
            task.status = "failed"
            task.error = download_error
            this.tasks_failed = this.tasks_failed + 1

            confess "❌ ${this.name} failed: ${task.url}"
            confess "   Error: ${download_error}"
        } finally {
            this.status = "idle"
            this.current_task = void
        }

        exhale task
    }

    sigh get_stats() {
        exhale {
            "name": this.name,
            "status": this.status,
            "completed": this.tasks_completed,
            "failed": this.tasks_failed,
            "bytes": this.total_bytes_downloaded
        }
    }
}

# ============================================================================
# DOWNLOAD SUPERVISOR - Manages Worker Actors
# ============================================================================

class DownloadSupervisor {
    sigh init(num_workers) {
        this.workers = []
        this.task_queue = []
        this.completed_tasks = []
        this.failed_tasks = []
        this.total_tasks = 0

        confess "🏗️  Creating download supervisor with ${num_workers} workers..."

        # Create worker actors
        remember i = 0
        while i < num_workers {
            remember worker_name = "Worker-${i + 1}"
            remember worker = new DownloaderActor(worker_name)
            this.workers = this.workers + [worker]
            confess "   ✓ Created ${worker_name}"
            i = i + 1
        }

        confess "✅ Supervisor initialized"
    }

    sigh add_task(url, destination) {
        remember task = new DownloadTask(url, destination)
        this.task_queue = this.task_queue + [task]
        this.total_tasks = this.total_tasks + 1
        confess "📋 Added task: ${url}"
    }

    sigh add_batch(urls) {
        confess "📦 Adding batch of ${length_of(urls)} downloads..."

        for url in urls {
            remember destination = "/tmp/download_${this.total_tasks + 1}"
            this.add_task(url, destination)
        }

        confess "✓ Batch added"
    }

    sigh start() {
        confess ""
        confess "🚀 Starting concurrent downloads..."
        confess "   Total tasks: ${this.total_tasks}"
        confess "   Workers: ${length_of(this.workers)}"
        confess ""

        # Distribute tasks to workers using round-robin
        remember task_index = 0
        remember worker_index = 0

        while task_index < length_of(this.task_queue) {
            remember task = this.task_queue[task_index]
            remember worker = this.workers[worker_index]

            # Assign task to worker
            remember result = worker.download(task)

            # Track completion
            if result.is_complete() {
                this.completed_tasks = this.completed_tasks + [result]
            } else {
                if result.is_failed() {
                    this.failed_tasks = this.failed_tasks + [result]
                }
            }

            # Round-robin to next worker
            worker_index = (worker_index + 1) % length_of(this.workers)
            task_index = task_index + 1
        }

        confess ""
        confess "✅ All downloads processed"
        confess ""
    }

    sigh get_progress() {
        remember completed = length_of(this.completed_tasks)
        remember failed = length_of(this.failed_tasks)
        remember pending = this.total_tasks - completed - failed

        exhale {
            "total": this.total_tasks,
            "completed": completed,
            "failed": failed,
            "pending": pending,
            "progress_percent": (completed / this.total_tasks) * 100.0
        }
    }

    sigh get_statistics() {
        confess "📊 DOWNLOAD STATISTICS"
        confess "====================="
        confess ""

        remember progress = this.get_progress()

        confess "Tasks:"
        confess "   Total:     ${progress['total']}"
        confess "   Completed: ${progress['completed']}"
        confess "   Failed:    ${progress['failed']}"
        confess "   Pending:   ${progress['pending']}"
        confess "   Progress:  ${progress['progress_percent']}%"
        confess ""

        confess "Workers:"
        for worker in this.workers {
            remember stats = worker.get_stats()
            confess "   ${stats['name']}:"
            confess "      Status:    ${stats['status']}"
            confess "      Completed: ${stats['completed']}"
            confess "      Failed:    ${stats['failed']}"
            confess "      Downloaded: ${stats['bytes']} bytes"
        }

        confess ""

        # Calculate total bandwidth
        remember total_bytes = 0
        for worker in this.workers {
            remember stats = worker.get_stats()
            total_bytes = total_bytes + stats["bytes"]
        }

        confess "Total downloaded: ${total_bytes} bytes"
    }

    sigh retry_failed() {
        if length_of(this.failed_tasks) == 0 {
            confess "✓ No failed tasks to retry"
            exhale 0
        }

        confess "🔄 Retrying ${length_of(this.failed_tasks)} failed tasks..."

        remember retry_count = 0
        for failed_task in this.failed_tasks {
            # Create new task for retry
            remember new_task = new DownloadTask(
                failed_task.url,
                failed_task.destination
            )

            # Assign to first available worker
            remember worker = this.workers[0]
            remember result = worker.download(new_task)

            if result.is_complete() {
                this.completed_tasks = this.completed_tasks + [result]
                retry_count = retry_count + 1
            }
        }

        # Clear failed tasks
        this.failed_tasks = []

        confess "✓ Retried ${retry_count} tasks successfully"
        exhale retry_count
    }
}

# ============================================================================
# PROGRESS MONITOR - Tracks Download Progress
# ============================================================================

class ProgressMonitor {
    sigh init() {
        this.snapshots = []
        this.snapshot_count = 0
    }

    sigh take_snapshot(supervisor) {
        this.snapshot_count = this.snapshot_count + 1
        remember progress = supervisor.get_progress()

        remember snapshot = {
            "id": this.snapshot_count,
            "timestamp": this.snapshot_count * 100,
            "progress": progress
        }

        this.snapshots = this.snapshots + [snapshot]

        confess "📸 Snapshot #${this.snapshot_count}: ${progress['progress_percent']}% complete"
    }

    sigh show_timeline() {
        confess ""
        confess "⏱️  PROGRESS TIMELINE"
        confess "===================="
        confess ""

        for snapshot in this.snapshots {
            remember progress = snapshot["progress"]
            confess "Snapshot #${snapshot['id']} (t=${snapshot['timestamp']}):"
            confess "   Completed: ${progress['completed']}/${progress['total']}"
            confess "   Progress:  ${progress['progress_percent']}%"
        }

        confess ""
    }

    sigh rewind_to_snapshot(snapshot_id) {
        # Time-travel: restore progress state
        confess "⏪ Rewinding to snapshot #${snapshot_id}..."

        if snapshot_id <= length_of(this.snapshots) and snapshot_id > 0 {
            remember snapshot = this.snapshots[snapshot_id - 1]
            confess "✓ State at snapshot: ${snapshot['progress']['progress_percent']}% complete"
            exhale snapshot
        }

        confess "❌ Invalid snapshot ID"
        exhale void
    }
}

# ============================================================================
# DOWNLOAD CHANNEL - Message Passing Between Actors
# ============================================================================

class DownloadChannel {
    sigh init() {
        this.messages = []
        this.message_count = 0
    }

    sigh send(message) {
        this.message_count = this.message_count + 1
        remember msg = {
            "id": this.message_count,
            "type": message["type"],
            "data": message["data"]
        }
        this.messages = this.messages + [msg]
        confess "📤 Channel: Sent message #${this.message_count} (${msg['type']})"
    }

    sigh receive() {
        if length_of(this.messages) > 0 {
            remember msg = this.messages[0]
            # In real implementation, would remove first message
            confess "📥 Channel: Received message #${msg['id']} (${msg['type']})"
            exhale msg
        }
        exhale void
    }

    sigh is_empty() {
        exhale length_of(this.messages) == 0
    }
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

confess "=== LAMENT CONCURRENT DOWNLOADER DEMO ==="
confess ""

# Create download URLs
remember urls = [
    "https://example.com/file1.zip",
    "https://example.com/file2.tar.gz",
    "https://example.com/file3.iso",
    "https://example.com/file4.dmg",
    "https://example.com/file5.exe",
    "https://example.com/file6.deb",
    "https://example.com/file7.rpm",
    "https://example.com/file8.pkg"
]

# Create supervisor with 3 worker actors
remember supervisor = new DownloadSupervisor(3)

confess ""

# Add downloads
supervisor.add_batch(urls)

confess ""

# Create progress monitor
remember monitor = new ProgressMonitor()

confess ""

# Take initial snapshot
monitor.take_snapshot(supervisor)

# Start downloads
supervisor.start()

# Take final snapshot
monitor.take_snapshot(supervisor)

# Show statistics
supervisor.get_statistics()

# Show timeline
monitor.show_timeline()

# Demonstrate time-travel
remember snapshot = monitor.rewind_to_snapshot(1)

confess ""

# Test channel communication
confess "📡 Testing actor communication channels..."
confess ""

remember channel = new DownloadChannel()

channel.send({"type": "START", "data": "Beginning downloads"})
channel.send({"type": "PROGRESS", "data": "50% complete"})
channel.send({"type": "COMPLETE", "data": "All downloads finished"})

remember msg1 = channel.receive()
remember msg2 = channel.receive()
remember msg3 = channel.receive()

confess ""
confess "=== FEATURES DEMONSTRATED ==="
confess "✓ Actor-based parallelism with worker actors"
confess "✓ Download supervisor for task coordination"
confess "✓ Round-robin work distribution"
confess "✓ Progress tracking with temporal snapshots"
confess "✓ Error handling and retry mechanism"
confess "✓ Inter-actor communication with channels"
confess "✓ Real-time statistics and monitoring"
confess "✓ Time-travel debugging of download progress"
confess "✓ Automatic error recovery with supervision"
confess ""
confess "🏆 Lament's advantages over Python:"
confess "   • Built-in actor system (no asyncio complexity)"
confess "   • Automatic work-stealing scheduler"
confess "   • Temporal progress tracking (rewind downloads)"
confess "   • Channel-based message passing (no locks!)"
confess "   • Supervision trees for fault tolerance"
confess "   • Zero-overhead actor creation"
confess "   • Pattern matching for message dispatch"
confess ""
