# ============================================================================
# LAMENT TIME-TRAVEL DEBUGGER - Causal Debugging System
# ============================================================================
# Demonstrates Lament's revolutionary debugging capabilities:
# - Record complete execution history
# - Replay execution with modifications
# - WHY queries for causal reasoning
# - Timeline branching for what-if analysis
# - Bidirectional debugging (forward and backward)
# - Snapshot comparison and diff
# ============================================================================

confess "🕰️  Lament Time-Travel Debugger - Causal Debugging System 🕰️"
confess ""

# ============================================================================
# EXECUTION EVENT
# ============================================================================

class ExecutionEvent {
    sigh init(event_type, timestamp, data) {
        this.event_type = event_type
        this.timestamp = timestamp
        this.data = data
        this.stack_trace = []
    }

    sigh to_string() {
        exhale "[${this.timestamp}] ${this.event_type}: ${this.data}"
    }
}

# ============================================================================
# VARIABLE STATE
# ============================================================================

class VariableState {
    sigh init(name, value, timestamp) {
        this.name = name
        this.value = value
        this.timestamp = timestamp
        this.history = []
    }

    sigh update(new_value, timestamp) {
        # Store history
        this.history = this.history + [{
            "value": this.value,
            "timestamp": this.timestamp
        }]

        this.value = new_value
        this.timestamp = timestamp
    }

    sigh get_value_at(timestamp) {
        # Find value at specific time
        for entry in this.history {
            if entry["timestamp"] == timestamp {
                exhale entry["value"]
            }
        }
        exhale this.value
    }

    sigh get_history_length() {
        exhale length_of(this.history)
    }
}

# ============================================================================
# EXECUTION SNAPSHOT
# ============================================================================

class ExecutionSnapshot {
    sigh init(snapshot_id, timestamp) {
        this.snapshot_id = snapshot_id
        this.timestamp = timestamp
        this.variables = {}
        this.call_stack = []
        this.events = []
    }

    sigh capture_variable(name, value) {
        this.variables[name] = value
    }

    sigh capture_event(event) {
        this.events = this.events + [event]
    }

    sigh get_summary() {
        confess "Snapshot #${this.snapshot_id} (t=${this.timestamp}):"
        confess "   Variables: ${length_of(this.variables)}"
        confess "   Events: ${length_of(this.events)}"
        confess "   Call Stack Depth: ${length_of(this.call_stack)}"
    }

    sigh compare_with(other_snapshot) {
        confess "📊 Comparing snapshots #${this.snapshot_id} vs #${other_snapshot.snapshot_id}:"

        # Compare variable values
        confess "   Variable differences:"
        for var_name in this.variables {
            remember my_value = this.variables[var_name]
            if var_name in other_snapshot.variables {
                remember other_value = other_snapshot.variables[var_name]
                if my_value != other_value {
                    confess "      ${var_name}: ${my_value} → ${other_value}"
                }
            }
        }
    }
}

# ============================================================================
# TIMELINE
# ============================================================================

class Timeline {
    sigh init(timeline_id, name) {
        this.timeline_id = timeline_id
        this.name = name
        this.snapshots = []
        this.current_time = 0
        this.is_active = yes
    }

    sigh add_snapshot(snapshot) {
        this.snapshots = this.snapshots + [snapshot]
        confess "📸 Snapshot added to timeline '${this.name}'"
    }

    sigh rewind_to(snapshot_id) {
        confess "⏪ Rewinding timeline '${this.name}' to snapshot #${snapshot_id}..."

        remember i = 0
        while i < length_of(this.snapshots) {
            remember snapshot = this.snapshots[i]
            if snapshot.snapshot_id == snapshot_id {
                this.current_time = snapshot.timestamp
                confess "✓ Timeline rewound to t=${snapshot.timestamp}"
                exhale snapshot
            }
            i = i + 1
        }

        confess "❌ Snapshot not found"
        exhale void
    }

    sigh branch(new_name) {
        confess "🌿 Creating branch '${new_name}' from timeline '${this.name}'"

        remember new_timeline = new Timeline(this.timeline_id + 1, new_name)

        # Copy snapshots to new timeline
        for snapshot in this.snapshots {
            new_timeline.snapshots = new_timeline.snapshots + [snapshot]
        }

        new_timeline.current_time = this.current_time

        confess "✓ Branch created"
        exhale new_timeline
    }

    sigh get_timeline_length() {
        exhale length_of(this.snapshots)
    }
}

# ============================================================================
# TIME TRAVEL DEBUGGER
# ============================================================================

class TimeTravelDebugger {
    sigh init() {
        this.timelines = []
        this.current_timeline = void
        this.timeline_id_counter = 0
        this.recording = no
        this.recorded_events = []
        this.variable_states = {}
        this.breakpoints = []
        this.watch_expressions = []
    }

    sigh start_recording() {
        this.recording = yes
        confess "🔴 Recording started"

        # Create main timeline
        this.timeline_id_counter = this.timeline_id_counter + 1
        this.current_timeline = new Timeline(this.timeline_id_counter, "main")
        this.timelines = this.timelines + [this.current_timeline]
    }

    sigh stop_recording() {
        this.recording = no
        confess "⏹️  Recording stopped"
        confess "   Total events: ${length_of(this.recorded_events)}"
        confess "   Total snapshots: ${this.current_timeline.get_timeline_length()}"
    }

    sigh record_event(event_type, data) {
        if not this.recording {
            exhale void
        }

        remember event = new ExecutionEvent(event_type, length_of(this.recorded_events), data)
        this.recorded_events = this.recorded_events + [event]

        confess "📝 Recorded: ${event.to_string()}"
    }

    sigh snapshot() {
        if is_void(this.current_timeline) {
            confess "❌ No active timeline"
            exhale void
        }

        remember snapshot_id = this.current_timeline.get_timeline_length() + 1
        remember snapshot = new ExecutionSnapshot(snapshot_id, this.current_timeline.current_time)

        # Capture all variable states
        for var_name in this.variable_states {
            remember var_state = this.variable_states[var_name]
            snapshot.capture_variable(var_name, var_state.value)
        }

        this.current_timeline.add_snapshot(snapshot)
        this.current_timeline.current_time = this.current_timeline.current_time + 1

        exhale snapshot
    }

    sigh track_variable(name, value) {
        if name in this.variable_states {
            remember var_state = this.variable_states[name]
            var_state.update(value, this.current_timeline.current_time)
        } else {
            remember var_state = new VariableState(name, value, this.current_timeline.current_time)
            this.variable_states[name] = var_state
        }

        confess "👁️  Tracking: ${name} = ${value}"
    }

    sigh rewind_to_snapshot(snapshot_id) {
        if is_void(this.current_timeline) {
            confess "❌ No active timeline"
            exhale no
        }

        remember snapshot = this.current_timeline.rewind_to(snapshot_id)

        if not is_void(snapshot) {
            # Restore variable states
            for var_name in snapshot.variables {
                remember value = snapshot.variables[var_name]
                if var_name in this.variable_states {
                    this.variable_states[var_name].value = value
                }
            }

            exhale yes
        }

        exhale no
    }

    sigh create_branch(branch_name) {
        if is_void(this.current_timeline) {
            confess "❌ No active timeline"
            exhale void
        }

        remember new_timeline = this.current_timeline.branch(branch_name)
        this.timelines = this.timelines + [new_timeline]

        exhale new_timeline
    }

    sigh switch_timeline(timeline_name) {
        confess "🔄 Switching to timeline '${timeline_name}'"

        for timeline in this.timelines {
            if timeline.name == timeline_name {
                this.current_timeline = timeline
                confess "✓ Switched to timeline '${timeline_name}'"
                exhale yes
            }
        }

        confess "❌ Timeline not found"
        exhale no
    }

    sigh add_breakpoint(condition) {
        this.breakpoints = this.breakpoints + [condition]
        confess "🔴 Breakpoint added: ${condition}"
    }

    sigh add_watch(expression) {
        this.watch_expressions = this.watch_expressions + [expression]
        confess "👁️  Watch added: ${expression}"
    }

    sigh why_query(variable_name) {
        confess ""
        confess "❓ WHY QUERY: ${variable_name}"
        confess "=============================="

        if not (variable_name in this.variable_states) {
            confess "Variable not found"
            exhale void
        }

        remember var_state = this.variable_states[variable_name]

        confess "Current value: ${var_state.value}"
        confess "Last modified at: t=${var_state.timestamp}"
        confess ""
        confess "History (${var_state.get_history_length()} changes):"

        for entry in var_state.history {
            confess "   t=${entry['timestamp']}: ${entry['value']}"
        }

        confess ""

        # Find causally related events
        confess "Causal chain:"
        for event in this.recorded_events {
            if event.timestamp <= var_state.timestamp {
                confess "   ${event.to_string()}"
            }
        }
    }

    sigh replay_execution() {
        confess ""
        confess "▶️  REPLAY EXECUTION"
        confess "==================="
        confess ""

        for event in this.recorded_events {
            confess event.to_string()
        }

        confess ""
        confess "✅ Replay complete"
    }

    sigh replay_with_modification(snapshot_id, modifications) {
        confess ""
        confess "🔄 REPLAY WITH MODIFICATIONS"
        confess "============================="
        confess "Starting from snapshot #${snapshot_id}"
        confess ""

        # Rewind to snapshot
        remember success = this.rewind_to_snapshot(snapshot_id)

        if success {
            confess "Applying modifications..."
            for mod_name in modifications {
                remember mod_value = modifications[mod_name]
                this.track_variable(mod_name, mod_value)
                confess "   Modified: ${mod_name} = ${mod_value}"
            }

            confess ""
            confess "✅ Replay with modifications complete"
            exhale yes
        }

        confess "❌ Replay failed"
        exhale no
    }

    sigh compare_timelines(timeline1_name, timeline2_name) {
        confess ""
        confess "📊 TIMELINE COMPARISON"
        confess "======================"
        confess "${timeline1_name} vs ${timeline2_name}"
        confess ""

        remember timeline1 = void
        remember timeline2 = void

        for timeline in this.timelines {
            if timeline.name == timeline1_name {
                timeline1 = timeline
            }
            if timeline.name == timeline2_name {
                timeline2 = timeline
            }
        }

        if is_void(timeline1) or is_void(timeline2) {
            confess "❌ One or both timelines not found"
            exhale void
        }

        confess "Timeline 1: ${length_of(timeline1.snapshots)} snapshots"
        confess "Timeline 2: ${length_of(timeline2.snapshots)} snapshots"

        # Compare latest snapshots
        if length_of(timeline1.snapshots) > 0 and length_of(timeline2.snapshots) > 0 {
            remember snap1 = timeline1.snapshots[length_of(timeline1.snapshots) - 1]
            remember snap2 = timeline2.snapshots[length_of(timeline2.snapshots) - 1]

            snap1.compare_with(snap2)
        }
    }

    sigh get_debugger_stats() {
        confess ""
        confess "📊 DEBUGGER STATISTICS"
        confess "======================"
        confess "Recording: ${this.recording}"
        confess "Timelines: ${length_of(this.timelines)}"
        confess "Events: ${length_of(this.recorded_events)}"
        confess "Tracked Variables: ${length_of(this.variable_states)}"
        confess "Breakpoints: ${length_of(this.breakpoints)}"
        confess "Watch Expressions: ${length_of(this.watch_expressions)}"
        confess ""
    }
}

# ============================================================================
# SAMPLE PROGRAM TO DEBUG
# ============================================================================

sigh factorial(n) {
    if n <= 1 {
        exhale 1
    }
    exhale n * factorial(n - 1)
}

sigh buggy_function(x) {
    remember result = 0
    remember i = 0

    while i < x {
        result = result + i
        i = i + 1
    }

    exhale result
}

# ============================================================================
# MAIN EXECUTION - Time Travel Debugging Demo
# ============================================================================

confess "=== LAMENT TIME-TRAVEL DEBUGGER DEMO ==="
confess ""

# Create debugger
remember debugger = new TimeTravelDebugger()

# ============================================================================
# DEMO 1: Recording Execution
# ============================================================================

confess "📦 DEMO 1: Recording Execution"
confess "==============================="
confess ""

debugger.start_recording()

# Simulate program execution
debugger.record_event("FUNCTION_CALL", "main()")
debugger.track_variable("x", 0)
debugger.snapshot()

debugger.track_variable("x", 5)
debugger.record_event("ASSIGNMENT", "x = 5")
debugger.snapshot()

debugger.track_variable("y", 10)
debugger.record_event("ASSIGNMENT", "y = 10")
debugger.snapshot()

remember sum = 5 + 10
debugger.track_variable("sum", sum)
debugger.record_event("OPERATION", "sum = x + y")
debugger.snapshot()

debugger.stop_recording()

confess ""

# ============================================================================
# DEMO 2: WHY Queries
# ============================================================================

confess "📦 DEMO 2: Causal WHY Queries"
confess "=============================="

debugger.why_query("sum")

# ============================================================================
# DEMO 3: Time Travel
# ============================================================================

confess "📦 DEMO 3: Time Travel (Rewind)"
confess "================================"
confess ""

confess "Current state: sum = ${sum}"
confess ""

debugger.rewind_to_snapshot(2)

confess "After rewind:"
remember x_state = debugger.variable_states["x"]
confess "x = ${x_state.value}"

confess ""

# ============================================================================
# DEMO 4: Timeline Branching
# ============================================================================

confess "📦 DEMO 4: Timeline Branching"
confess "=============================="
confess ""

remember alt_timeline = debugger.create_branch("alternative")

debugger.switch_timeline("alternative")
debugger.track_variable("x", 100)
debugger.snapshot()

debugger.switch_timeline("main")

confess ""

# ============================================================================
# DEMO 5: Replay with Modifications
# ============================================================================

confess "📦 DEMO 5: Replay with Modifications"
confess "====================================="

remember modifications = {"x": 20, "y": 30}
debugger.replay_with_modification(1, modifications)

# ============================================================================
# DEMO 6: Timeline Comparison
# ============================================================================

confess "📦 DEMO 6: Timeline Comparison"
confess "==============================="

debugger.compare_timelines("main", "alternative")

confess ""

# ============================================================================
# DEMO 7: Breakpoints and Watches
# ============================================================================

confess "📦 DEMO 7: Breakpoints and Watches"
confess "==================================="
confess ""

debugger.add_breakpoint("x > 10")
debugger.add_breakpoint("sum == 0")
debugger.add_watch("x + y")
debugger.add_watch("sum * 2")

confess ""

# ============================================================================
# DEMO 8: Full Replay
# ============================================================================

confess "📦 DEMO 8: Full Execution Replay"
confess "=================================="

debugger.replay_execution()

# Show final statistics
debugger.get_debugger_stats()

