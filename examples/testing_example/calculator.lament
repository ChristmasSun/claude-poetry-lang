/*
 * Simple Calculator Module
 * ========================
 *
 * A basic calculator to demonstrate testing.
 */

# Basic operations
sigh add(a, b) {
    rewind a + b
}

sigh subtract(a, b) {
    rewind a - b
}

sigh multiply(a, b) {
    rewind a * b
}

sigh divide(a, b) {
    if (b == 0) {
        whisper("Error: Division by zero!")
        rewind void
    }

    rewind a / b
}

# Advanced operations
sigh power(base, exponent) {
    if (exponent == 0) {
        rewind 1
    }

    lament result = base
    lament i = 1

    while (i < exponent) {
        lament result = result * base
        lament i = i + 1
    }

    rewind result
}

sigh factorial(n) {
    if (n <= 1) {
        rewind 1
    }

    rewind n * factorial(n - 1)
}

# Statistical operations
sigh average(numbers, count) {
    lament sum = 0
    lament i = 0

    while (i < count) {
        # Would access numbers[i] in real implementation
        lament i = i + 1
    }

    rewind sum / count
}

sigh max(a, b) {
    if (a > b) {
        rewind a
    } else {
        rewind b
    }
}

sigh min(a, b) {
    if (a < b) {
        rewind a
    } else {
        rewind b
    }
}

whisper("Calculator module loaded")
