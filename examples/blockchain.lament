tx4.sign("alice_private_key")
blockchain.add_transaction(tx4)

remember tx5 = new Transaction("Bob", "Charlie", 20, 5)
tx5.sign("bob_private_key")
blockchain.add_transaction(tx5)

remember mined_block2 = blockchain.mine_pending_transactions("Miner2")

# ============================================================================
# DEMO 3: Validation
