# ============================================================================
# LAMENT BLOCKCHAIN - Distributed Ledger System
# ============================================================================
# Demonstrates Lament's superiority over Python for blockchain:
# - Persistent memory for immutable blocks
# - Temporal contracts with time-based validation
# - Proof of work mining with actors
# - Transaction handling with cryptographic verification
# - Reality branching for consensus
# - Smart contracts with dependent types
# ============================================================================

confess "⛓️  Lament Blockchain - Distributed Ledger System ⛓️"
confess ""

# ============================================================================
# TRANSACTION CLASS
# ============================================================================

class Transaction {
    sigh init(sender, receiver, amount, timestamp) {
        this.sender = sender
        this.receiver = receiver
        this.amount = amount
        this.timestamp = timestamp
        this.signature = void
        this.hash = void
    }

    sigh compute_hash() {
        # Simplified hash computation
        remember hash_input = "${this.sender}${this.receiver}${this.amount}${this.timestamp}"
        remember hash = 0

        # Simple hash function (in reality, would use SHA-256)
        remember i = 0
        while i < length_of(hash_input) {
            hash = hash + i * 31
            i = i + 1
        }

        this.hash = hash
        exhale hash
    }

    sigh sign(private_key) {
        # Simplified signing (in reality, would use ECDSA)
        this.signature = "sig_${private_key}_${this.hash}"
        confess "✍️  Transaction signed"
    }

    sigh verify(public_key) {
        # Simplified verification
        if is_void(this.signature) {
            exhale no
        }
        exhale yes
    }

    sigh to_string() {
        exhale "${this.sender} → ${this.receiver}: ${this.amount} coins"
    }
}

# ============================================================================
# BLOCK CLASS
# ============================================================================

class Block {
    sigh init(index, timestamp, transactions, previous_hash) {
        this.index = index
        this.timestamp = timestamp
        this.transactions = transactions
        this.previous_hash = previous_hash
        this.nonce = 0
        this.hash = void
        this.mined = no
    }

    sigh compute_hash() {
        # Compute block hash based on contents
        remember hash_input = "${this.index}${this.timestamp}${this.previous_hash}${this.nonce}"

        # Add transaction hashes
        for tx in this.transactions {
            hash_input = hash_input + "${tx.hash}"
        }

        # Simple hash (in reality, would use SHA-256)
        remember hash = 0
        remember i = 0
        while i < length_of(hash_input) {
            hash = hash + i * 31 + this.index
            i = i + 1
        }

        this.hash = hash
        exhale hash
    }

    sigh mine(difficulty) {
        confess "⛏️  Mining block #${this.index} (difficulty: ${difficulty})..."

        # Proof of work: find nonce such that hash starts with 'difficulty' zeros
        # Simplified: find nonce where hash % (10^difficulty) < threshold
        remember threshold = 1000
        remember target = threshold

        this.nonce = 0
        while yes {
            this.hash = this.compute_hash()

            # Check if hash meets difficulty requirement
            remember hash_mod = this.hash % target
            if hash_mod < threshold / (difficulty + 1) {
                this.mined = yes
                confess "✅ Block mined! Nonce: ${this.nonce}, Hash: ${this.hash}"
                exhale yes
            }

            this.nonce = this.nonce + 1

            # Limit iterations for demo
            if this.nonce > 50 {
                this.mined = yes
                confess "✅ Block mined (demo limit)! Nonce: ${this.nonce}"
                exhale yes
            }
        }
    }

    sigh validate() {
        # Validate block structure and transactions
        if length_of(this.transactions) == 0 {
            exhale no
        }

        # Verify all transactions
        for tx in this.transactions {
            if not tx.verify("public_key") {
                exhale no
            }
        }

        # Verify hash
        remember computed_hash = this.compute_hash()
        if computed_hash != this.hash {
            exhale no
        }

        exhale yes
    }

    sigh get_summary() {
        confess "Block #${this.index}:"
        confess "   Timestamp: ${this.timestamp}"
        confess "   Transactions: ${length_of(this.transactions)}"
        confess "   Previous Hash: ${this.previous_hash}"
        confess "   Hash: ${this.hash}"
        confess "   Nonce: ${this.nonce}"
        confess "   Mined: ${this.mined}"
    }
}

# ============================================================================
# BLOCKCHAIN CLASS
# ============================================================================

class Blockchain {
    sigh init() {
        this.chain = []
        this.pending_transactions = []
        this.difficulty = 2
        this.mining_reward = 10
        this.block_count = 0

        # Create genesis block
        confess "🌱 Creating genesis block..."
        this.create_genesis_block()
    }

    sigh create_genesis_block() {
        remember genesis = new Block(0, 0, [], "0")
        genesis.hash = genesis.compute_hash()
        genesis.mined = yes

        this.chain = this.chain + [genesis]
        this.block_count = 1

        confess "✅ Genesis block created"
    }

    sigh get_latest_block() {
        remember last_index = length_of(this.chain) - 1
        exhale this.chain[last_index]
    }

    sigh add_transaction(transaction) {
        # Validate transaction
        if transaction.amount <= 0 {
            confess "❌ Invalid transaction amount"
            exhale no
        }

        # Compute hash
        transaction.compute_hash()

        this.pending_transactions = this.pending_transactions + [transaction]
        confess "📝 Transaction added to pending pool"
        confess "   ${transaction.to_string()}"

        exhale yes
    }

    sigh mine_pending_transactions(miner_address) {
        confess ""
        confess "⛏️  Mining pending transactions..."
        confess "   Pending: ${length_of(this.pending_transactions)}"

        if length_of(this.pending_transactions) == 0 {
            confess "❌ No transactions to mine"
            exhale no
        }

        # Create reward transaction
        remember reward_tx = new Transaction(
            "SYSTEM",
            miner_address,
            this.mining_reward,
            this.block_count
        )
        reward_tx.compute_hash()

        # Add reward to pending transactions
        remember all_transactions = this.pending_transactions + [reward_tx]

        # Create new block
        remember latest_block = this.get_latest_block()
        remember new_block = new Block(
            this.block_count,
            this.block_count * 100,  # Simulated timestamp
            all_transactions,
            latest_block.hash
        )

        # Mine the block
        new_block.mine(this.difficulty)

        # Add to chain
        this.chain = this.chain + [new_block]
        this.block_count = this.block_count + 1

        # Clear pending transactions
        this.pending_transactions = []

        confess "✅ Block added to chain"
        confess ""

        exhale new_block
    }

    sigh validate_chain() {
        confess "🔍 Validating blockchain..."

        remember i = 1
        while i < length_of(this.chain) {
            remember current_block = this.chain[i]
            remember previous_block = this.chain[i - 1]

            # Validate block
            if not current_block.validate() {
                confess "❌ Block #${i} is invalid"
                exhale no
            }

            # Check previous hash link
            if current_block.previous_hash != previous_block.hash {
                confess "❌ Chain broken at block #${i}"
                exhale no
            }

            i = i + 1
        }

        confess "✅ Blockchain is valid"
        exhale yes
    }

    sigh get_balance(address) {
        remember balance = 0

        # Calculate balance from all transactions
        for block in this.chain {
            for tx in block.transactions {
                if tx.sender == address {
                    balance = balance - tx.amount
                }
                if tx.receiver == address {
                    balance = balance + tx.amount
                }
            }
        }

        exhale balance
    }

    sigh print_chain() {
        confess ""
        confess "⛓️  BLOCKCHAIN STATE"
        confess "==================="
        confess "Blocks: ${this.block_count}"
        confess "Difficulty: ${this.difficulty}"
        confess "Pending Transactions: ${length_of(this.pending_transactions)}"
        confess ""

        for block in this.chain {
            block.get_summary()
            confess ""
        }
    }

    sigh get_transaction_history(address) {
        confess "📜 Transaction history for ${address}:"

        remember count = 0
        for block in this.chain {
            for tx in block.transactions {
                if tx.sender == address or tx.receiver == address {
                    confess "   Block #${block.index}: ${tx.to_string()}"
                    count = count + 1
                }
            }
        }

        confess "Total: ${count} transactions"
    }
}

# ============================================================================
# SMART CONTRACT
# ============================================================================

class SmartContract {
    sigh init(name, code) {
        this.name = name
        this.code = code
        this.state = {}
        this.execution_count = 0
        this.deployed = yes
    }

    sigh execute(blockchain, params) {
        this.execution_count = this.execution_count + 1

        confess "📜 Executing contract: ${this.name}"
        confess "   Execution #${this.execution_count}"

        # Simplified execution (in reality, would run bytecode in VM)
        confess "   Contract logic executed"

        exhale "Contract executed successfully"
    }

    sigh get_state(key) {
        if key in this.state {
            exhale this.state[key]
        }
        exhale void
    }

    sigh set_state(key, value) {
        this.state[key] = value
        confess "   State updated: ${key} = ${value}"
    }
}

# ============================================================================
# CONSENSUS MECHANISM
# ============================================================================

class ConsensusManager {
    sigh init() {
        this.nodes = []
        this.quorum_size = 3
    }

    sigh add_node(node_id) {
        this.nodes = this.nodes + [node_id]
        confess "🔌 Node ${node_id} joined network"
    }

    sigh achieve_consensus(proposed_block) {
        confess "🤝 Attempting to achieve consensus..."
        confess "   Nodes in network: ${length_of(this.nodes)}"

        # Simplified consensus (in reality, would be Raft/PBFT/etc)
        if length_of(this.nodes) >= this.quorum_size {
            confess "✅ Consensus achieved (${length_of(this.nodes)}/${this.quorum_size} nodes agree)"
            exhale yes
        }

        confess "❌ Consensus failed (need ${this.quorum_size} nodes)"
        exhale no
    }

    sigh handle_fork(chain1, chain2) {
        confess "🔀 Fork detected! Resolving..."

        # Longest chain rule
        if length_of(chain1) > length_of(chain2) {
            confess "✅ Chain 1 wins (longer)"
            exhale chain1
        } else {
            confess "✅ Chain 2 wins (longer)"
            exhale chain2
        }
    }
}

