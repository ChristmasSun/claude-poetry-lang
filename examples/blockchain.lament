remember tx2 = new Transaction("Bob", "Charlie", 25, 2)
tx2.sign("bob_private_key")
blockchain.add_transaction(tx2)

remember tx3 = new Transaction("Charlie", "Alice", 10, 3)
tx3.sign("charlie_private_key")
blockchain.add_transaction(tx3)

confess ""

# ============================================================================
# DEMO 2: Mining
# ============================================================================

confess "📦 DEMO 2: Mining Blocks"
confess "========================"
confess ""

remember mined_block = blockchain.mine_pending_transactions("Miner1")
