# ============================================================================
# DEMO 5: Smart Contracts
# ============================================================================

confess "📦 DEMO 5: Smart Contracts"
confess "==========================="
confess ""

remember contract = new SmartContract(
    "TokenTransfer",
    "sigh transfer(from, to, amount) { ... }"
)

remember result = contract.execute(blockchain, {"from": "Alice", "to": "Bob", "amount": 5})
confess "Contract result: ${result}"

contract.set_state("total_transfers", 1)
remember state = contract.get_state("total_transfers")
confess "Contract state: total_transfers = ${state}"

confess ""

# ============================================================================
# DEMO 6: Consensus
# ============================================================================

confess "📦 DEMO 6: Consensus Mechanism"
confess "==============================="
