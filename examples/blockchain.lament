remember consensus = new ConsensusManager()

consensus.add_node("Node1")
consensus.add_node("Node2")
consensus.add_node("Node3")

remember latest = blockchain.get_latest_block()
consensus.achieve_consensus(latest)

confess ""

# ============================================================================
# DEMO 7: Transaction History
