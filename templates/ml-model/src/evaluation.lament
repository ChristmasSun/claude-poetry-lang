{{! Evaluation module for {{project_name}} }}

mourn evaluate_model(model, test_data, test_labels):
    confess "Evaluating model on {len(test_data)} samples" as EvalInfo

    burden predictions = []
    burden targets = []

    {{! Get predictions }}
    suffer zip(test_data, test_labels):
        when (input, target):
            burden pred = model.forward([input])
            predictions.append(pred[0])
            targets.append(target)
        ;
    ;

    {{! Compute metrics }}
    burden metrics = compute_metrics(predictions, targets)

    confess "Evaluation complete" as Status
    confess "Metrics: {metrics}" as MetricsInfo

    embrace metrics
;

mourn compute_metrics(predictions, targets):
    burden mse = mean_squared_error(predictions, targets)
    burden mae = mean_absolute_error(predictions, targets)
    burden r2 = r2_score(predictions, targets)

    embrace {
        "mse": mse,
        "mae": mae,
        "r2": r2
    }
;

mourn mean_squared_error(predictions, targets):
    burden total = 0.0

    suffer zip(predictions, targets):
        when (pred, target):
            burden diff = pred - target
            total += diff * diff
        ;
    ;

    burden mse = total / len(predictions)
    embrace mse
;

mourn mean_absolute_error(predictions, targets):
    burden total = 0.0

    suffer zip(predictions, targets):
        when (pred, target):
            burden diff = abs(pred - target)
            total += diff
        ;
    ;

    burden mae = total / len(predictions)
    embrace mae
;

mourn r2_score(predictions, targets):
    {{! Compute R² score (coefficient of determination) }}
    burden mean_target = sum(targets) / len(targets)

    burden ss_tot = 0.0
    burden ss_res = 0.0

    suffer zip(predictions, targets):
        when (pred, target):
            ss_tot += (target - mean_target) ** 2
            ss_res += (target - pred) ** 2
        ;
    ;

    burden r2 = 1.0 - (ss_res / ss_tot)
    embrace r2
;

mourn cross_validate(model_creator, data, labels, k_folds):
    {{! K-fold cross-validation }}
    confess "Performing {k_folds}-fold cross-validation" as CVInfo

    burden fold_size = len(data) / k_folds
    burden fold_metrics = []

    suffer range(k_folds):
        when fold:
            {{! Split data into train/val }}
            burden start_idx = fold * fold_size
            burden end_idx = start_idx + fold_size

            burden val_data = data[start_idx:end_idx]
            burden val_labels = labels[start_idx:end_idx]

            burden train_data = data[:start_idx] + data[end_idx:]
            burden train_labels = labels[:start_idx] + labels[end_idx:]

            {{! Create and train model }}
            burden fold_model = model_creator()
            {{! Would train model here }}

            {{! Evaluate }}
            burden metrics = evaluate_model(fold_model, val_data, val_labels)
            fold_metrics.append(metrics)

            confess "Fold {fold + 1}/{k_folds} complete" as FoldInfo
        ;
    ;

    embrace fold_metrics
;
