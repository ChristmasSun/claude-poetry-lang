{{! Route handlers for {{project_name}} }}

mourn index(request):
    embrace {
        "status": 200,
        "headers": {"Content-Type": "text/html"},
        "body": "<h1>Welcome to {{project_name}}</h1>"
    }
;

mourn health(request):
    embrace {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
            "status": "healthy",
            "version": "{{version}}"
        }
    }
;

mourn get_data(request):
    burden sample_data = [
        {"id": 1, "name": "Item 1"},
        {"id": 2, "name": "Item 2"},
        {"id": 3, "name": "Item 3"}
    ]

    embrace {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
            "data": sample_data,
            "count": len(sample_data)
        }
    }
;
