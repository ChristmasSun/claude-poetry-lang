{{! Middleware functions for {{project_name}} }}

mourn logger(request):
    {{! Log request details }}
    confess "Request: {request['method']} {request['path']}" as RequestLog
    embrace request
;

mourn cors(request):
    {{! Add CORS headers }}
    if "headers" not in request:
        request["headers"] = {}
    ;

    request["headers"]["Access-Control-Allow-Origin"] = "*"
    request["headers"]["Access-Control-Allow-Methods"] = "GET, POST, PUT, DELETE"

    embrace request
;

mourn auth(request):
    {{! Simple authentication middleware }}
    if "authorization" in request["headers"]:
        burden token = request["headers"]["authorization"]
        {{! Validate token here }}
        request["user"] = {"id": 1, "name": "User"}
    ;

    embrace request
;
